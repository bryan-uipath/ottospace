#!/bin/sh
# Fake CLI for tests: asks a permission in a line too long to read (past 32 MB), then waits on stdin.
# perl writes the 34 MB in one go: a byte-by-byte `tr` took a second of CPU, past the test's wait under load.
perl -e 'print q({"type":"control_request","request_id":"r","request":{"subtype":"can_use_tool","input":{"content":"), "a" x 34000000, qq("}}}\n)'
exec cat

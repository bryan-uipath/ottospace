#!/bin/sh
# Fake `claude -p` for tests: records argv and stdin under $FAKE_DIR, and answers each line
# on stdin by replaying a fixture from $FAKE_FIXTURES. Starts no model session.
# An answer replays `turn<N>-allowed.jsonl` or `turn<N>-denied.jsonl` of the turn it answers,
# if the fixtures have one; an allow falls back to `turn1-allowed.jsonl`.
# `start.jsonl`, if there is one, is replayed first (the real CLI's hook lines). `$FAKE_EXIT`
# set: after it, the fake exits with that code before reading anything, with `$FAKE_STDERR` on
# stderr (as the real CLI does when its stdin closes before a message, or it fails to start).
# `$FAKE_SESSIONS` set: a new session (`--session-id <id>`) writes its file there, as the real CLI
# does under `projects/<cwd as a slug>/`, so it can be resumed; `--resume <id>` replays
# `resume.jsonl` first, if there is one (what a resume prints before it reads stdin).
# Its process id goes to `pid`: a test asks whether it outlived what started it.
printf '%s\n' "$@" >"$FAKE_DIR/argv"
echo $$ >"$FAKE_DIR/pid"
echo start >>"$FAKE_DIR/starts"
# A fixture line `{"_sleep":1.5}` is a pause of that many seconds, not a reply: calls that overlap.
replay() {
  while IFS= read -r reply || [ -n "$reply" ]; do
    case "$reply" in
      *'"_fixture"'*) ;;
      *'"_sleep"'*) sleep "$(printf '%s' "$reply" | tr -cd '0-9.')" ;;
      *) printf '%s\n' "$reply" ;;
    esac
  done <"$FAKE_FIXTURES/$1"
}
if [ -n "$FAKE_SESSIONS" ]; then
  prev=
  for arg in "$@"; do
    if [ "$prev" = "--session-id" ]; then
      dir="$FAKE_SESSIONS/projects/$(pwd -P | sed 's/[^A-Za-z0-9]/-/g')"
      mkdir -p "$dir"
      printf '{"type":"user","message":{"role":"user","content":"made-up"},"cwd":"%s","sessionId":"%s"}\n' "$(pwd -P)" "$arg" >"$dir/$arg.jsonl"
    fi
    [ "$prev" = "--resume" ] && [ -f "$FAKE_FIXTURES/resume.jsonl" ] && replay resume.jsonl
    prev=$arg
  done
fi
[ -f "$FAKE_FIXTURES/start.jsonl" ] && replay start.jsonl
# `$FAKE_CTL` set: once `ask-<n>` appears (n: this start's number), it sends that request with
# `$FAKE_OTTOSPACE ctl` as its tool shell would (`ctl-own-<n>`), with a made-up pass
# (`ctl-wrong-<n>`) and with none (`ctl-none-<n>`). A child in a group of its own, which outlives
# it (its group is killed when it ends), sends it again once `go-<n>` appears (`ctl-after-<n>`).
# Needs `perl` (macOS has it) for that group.
# Each waits 30 s at most.
if [ -n "$FAKE_CTL" ]; then
  n=$(wc -l <"$FAKE_DIR/starts" | tr -d ' ')
  await() { i=0; while [ ! -e "$FAKE_DIR/$1" ] && [ $i -lt 300 ]; do sleep 0.1; i=$((i + 1)); done; }
  await "ask-$n"
  # The pass itself, for the test to look for where it must never be (a dead one by then).
  printf '%s\n' "$OTTOSPACE_TASK_PASS" >"$FAKE_DIR/pass-$n"
  "$FAKE_OTTOSPACE" ctl "$FAKE_CTL" >"$FAKE_DIR/ctl-own-$n"
  OTTOSPACE_TASK_PASS=0123456789abcdef0123456789abcdef "$FAKE_OTTOSPACE" ctl "$FAKE_CTL" >"$FAKE_DIR/ctl-wrong-$n"
  env -u OTTOSPACE_TASK_PASS "$FAKE_OTTOSPACE" ctl "$FAKE_CTL" >"$FAKE_DIR/ctl-none-$n"
  export n
  # `apart-<n>`: in its own group, so out of reach of the kill of this one's when it ends.
  perl -e 'setpgrp(0, 0); exec @ARGV' sh -c ': >"$FAKE_DIR/apart-$n"
    i=0; while [ ! -e "$FAKE_DIR/go-$n" ] && [ $i -lt 300 ]; do sleep 0.1; i=$((i + 1)); done
    "$FAKE_OTTOSPACE" ctl "$FAKE_CTL" >"$FAKE_DIR/ctl-after-$n"' </dev/null >/dev/null 2>&1 &
  await "apart-$n"
fi
if [ -n "$FAKE_EXIT" ]; then
  [ -n "$FAKE_STDERR" ] && printf '%s\n' "$FAKE_STDERR" >&2
  exit "$FAKE_EXIT"
fi
turn=0
while IFS= read -r line; do
  printf '%s\n' "$line" >>"$FAKE_DIR/stdin"
  case "$line" in
    *'"type":"user"'*) turn=$((turn + 1)); replay "turn$turn.jsonl" ;;
    *'"behavior":"allow"'*)
      if [ -f "$FAKE_FIXTURES/turn$turn-allowed.jsonl" ]; then replay "turn$turn-allowed.jsonl"; else replay turn1-allowed.jsonl; fi ;;
    *'"behavior":"deny"'*) [ -f "$FAKE_FIXTURES/turn$turn-denied.jsonl" ] && replay "turn$turn-denied.jsonl" ;;
    *'"subtype":"interrupt"'*) replay turn2-interrupted.jsonl ;;
  esac
done
echo "fake claude: stdin closed" >&2
# `$FAKE_LINGER` set: it lives that many seconds more, as a CLI that ends its turn first.
[ -n "$FAKE_LINGER" ] && sleep "$FAKE_LINGER"
exit 3

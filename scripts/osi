#!/bin/sh
# ottospace-installer
# osi: installs builds of ottospace and switches between them. No sudo.
#   osi install main         the latest build of the main branch
#   osi install pr 30        the build of a pull request (needs gh, signed in)
#   osi install v0.1.0       a release; `osi install stable` is the latest release
#   osi current | update | rollback | uninstall | self-update
# Design and trade-offs: docs/ai/install-and-update.md
set -eu

# System tools only. The caller's PATH is kept to find gh and to check for the bin directory.
user_path="${PATH:-}"
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

repo="bryan-uipath/ottospace"
# Asset names and the main tag must match scripts/package.sh and .github/workflows/build.yml.
target="aarch64-apple-darwin"
tarball="ottospace-$target.tar.gz"
appzip="ottospace-$target.app.zip"
artifact="ottospace-$target"
main_tag="main-latest"
workflow="build.yml"
# The label that makes build.yml build a pull request. Must match .github/workflows/build.yml.
build_label="pr-build"
# jq: "true" when a pull request carries $build_label.
has_label='([.labels[].name] | index("'"$build_label"'") != null | tostring)'
# Second line of this file. install.sh and self-update replace only an osi that carries it.
marker="# ottospace-installer"
# Bump on every change to this file: an install replaces an older installed osi with the one
# its build carries, never with an older or equal one.
OSI_VERSION=1

tmp=""
bg=""
staged=""
staged_app=""
aside_app=""
app=""

say() { printf '%s\n' "$*"; }
die() {
  printf 'osi: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: osi <command>

  install main [--app]       the latest build of the main branch
  install pr <n> [--app]     the build of pull request <n> (needs gh, signed in)
  install stable [--app]     the latest release
  install <vX.Y.Z> [--app]   that release
  list                       builds you can install: main, and each open pull request
  current                    what is installed: channel, version, commit, date
  update [--check]           install the channel's newer build, if there is one (--no-wait too)
  rollback                   put the previous build back (again: undo the rollback)
  uninstall                  remove ottospace and osi; settings and tasks are kept
  self-update                replace osi with the one on main
  --version                  osi's version, and the build it installed

  --app          also install ottospace.app into ~/Applications
  --force        replace an `ottospace` command or app that osi did not install
  --allow-fork   allow a pull request from a fork (asks you to type its commit)
  --no-wait      do not wait for a pull request build (a missing one is still requested)

Run `ottospace` from a terminal: it uses that terminal's Accessibility and Screen Recording
permissions, so an update does not ask for them again. Undo an install: osi rollback.
A pull request build runs that pull request's code with your terminal's permissions.
EOF
}

# Runs on any exit: drops temp files and anything staged but not yet moved into place, and
# puts back an app that was moved aside if its replacement never arrived.
cleanup() {
  # Its children too: a download in a subshell runs curl, which ignores ^C in the background.
  if [ -n "$bg" ]; then
    pkill -P "$bg" 2>/dev/null || true
    kill "$bg" 2>/dev/null || true
  fi
  if [ -n "$staged" ]; then rm -f "$staged"; fi
  if [ -n "$staged_app" ]; then rm -rf "$staged_app"; fi
  if [ -n "$aside_app" ] && [ -e "$aside_app" ] && [ ! -e "$app" ]; then mv "$aside_app" "$app"; fi
  if [ -n "$tmp" ]; then rm -rf "$tmp"; fi
}

# HTTPS only, also across redirects. file:// is for tests: only an override can name one.
fetch() {
  case "$1" in
    https://*) curl -fsSL --proto '=https' --tlsv1.2 --retry 3 -o "$2" "$1" ;;
    file://*) curl -fsS --proto '=file' -o "$2" "$1" ;;
    *) die "refusing to download from $1" ;;
  esac
}

# First value of key $1 in the key=value file $2. State and BUILD files are read, never sourced.
get() {
  [ -f "$2" ] || return 0
  sed -n "s/^$1=//p" "$2" | head -n 1
}

# Values that go into state, messages and paths: no spaces, quotes or shell characters.
is_safe() {
  case "$1" in
    "" | *[!0-9A-Za-z.:+_-]*) return 1 ;;
  esac
}

is_sha() {
  case "$1" in
    *[!0-9a-f]*) return 1 ;;
  esac
  [ "${#1}" -eq "$2" ]
}

is_number() {
  case "$1" in
    "" | *[!0-9]*) return 1 ;;
  esac
}

short() { printf '%.12s' "$1"; }

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

sha256_of() { shasum -a 256 "$1" | awk '{ print $1 }'; }

# Checks file $1 in $dl against its line in $dl/SHA256SUMS.
verify() {
  want="$(awk -v name="$1" '$2 == name || $2 == "*" name { print $1; exit }' "$dl/SHA256SUMS")"
  is_sha "$want" 64 || die "SHA256SUMS has no checksum for $1. Nothing was changed."
  [ "$(sha256_of "$dl/$1")" = "$want" ] ||
    die "checksum mismatch for $1: the download is damaged, was changed, or a new build is being published. Nothing was changed. Try again in a minute."
}

setup() {
  [ "$(uname -s)" = Darwin ] || die "ottospace runs on macOS only."
  # hw.optional.arm64 is 1 on Apple Silicon, also under Rosetta where uname -m says x86_64.
  [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = 1 ] ||
    die "ottospace builds are for Apple Silicon only. Build from source on Intel Macs."
  case "${HOME:-}" in
    /*) ;;
    *) die "HOME must be an absolute path" ;;
  esac
  # Every path has an override, so tests never touch the real install.
  bin_dir="${OSI_BIN_DIR:-$HOME/.local/bin}"
  app_dir="${OSI_APP_DIR:-$HOME/Applications}"
  # Inside ottospace's own folder, beside settings.json and tasks/.
  state_dir="${OTTOSPACE_HOME:-$HOME/.ottospace}/install"
  releases="${OSI_RELEASES_URL:-https://github.com/$repo/releases}"
  self_url="${OSI_SELF_URL:-https://raw.githubusercontent.com/$repo/main/scripts/osi}"
  cmd="$bin_dir/ottospace"
  app="$app_dir/ottospace.app"
  trap cleanup EXIT
  trap 'spin_clear; exit 1' HUP INT TERM
  tmp="$(mktemp -d)"
  dl="$tmp/dl"
  mkdir "$dl"
}

# Finds gh on the caller's PATH. OSI_GH names another program, for tests.
gh_find() {
  gh_cmd="${OSI_GH:-}"
  if [ -z "$gh_cmd" ]; then
    gh_cmd="$(PATH="$user_path" command -v gh || true)"
  fi
  [ -n "$gh_cmd" ] || die "pull request builds need the GitHub CLI: https://cli.github.com (then: gh auth login)"
}

# GH_HOST and GH_REPO are dropped, and callers name github.com: no other host can stand in.
gh_run() { env -u GH_HOST -u GH_REPO PATH="$user_path" "$gh_cmd" "$@"; }

# True when osi has a record of installing the app at $app.
app_owned() { [ -f "$state_dir/app" ] && [ "$(get path "$state_dir/app")" = "$app" ]; }

# Where a release channel's files are. Sets $base.
release_base() {
  case "$1" in
    main) base="$releases/download/$main_tag" ;;
    stable) base="$releases/latest/download" ;;
    version) base="$releases/download/$2" ;;
  esac
}

# Reads pull request $1 from GitHub. Sets pr_state, pr_author, pr_sha, pr_head, pr_cross, and
# pr_labelled (true when it carries $build_label).
pr_read() {
  gh_find
  # Control characters are dropped, so a field cannot write to the terminal. No field may be
  # empty: `read` would skip it and shift the rest.
  line="$(gh_run pr view "$1" -R "github.com/$repo" \
    --json state,author,headRefOid,headRepository,isCrossRepository,labels \
    --jq '[.state, (.author.login // "unknown"), .headRefOid, (.headRepository.nameWithOwner // "deleted"), (.isCrossRepository | tostring), '"$has_label"'] | @tsv' |
    clean)" || line=""
  IFS="$(printf '\t')" read -r pr_state pr_author pr_sha pr_head pr_cross pr_labelled <<EOF
$line
EOF
  is_sha "$pr_sha" 40 || die "could not read pull request $1 of $repo (is gh signed in? gh auth status)"
}

# One spinner frame and "$1" on the current line, redrawn in place. Nothing unless a terminal.
spin_tick=0
spin() {
  [ -t 1 ] || return 0
  spin_msg="$1"
  set -- ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏
  shift $((spin_tick % 10))
  spin_tick=$((spin_tick + 1))
  printf '\r\033[2K%s %s' "$1" "$spin_msg"
}
spin_clear() { if [ -t 1 ]; then printf '\r\033[2K'; fi; }

# Spins "$2" until process $1 ends and leaves no line. Returns the process's status.
# The process is $bg while it runs, so an interrupted osi stops it (see cleanup).
spin_quiet() {
  bg="$1"
  while kill -0 "$1" 2>/dev/null; do
    spin "$2"
    sleep 0.1
  done
  spin_clear
  bg=""
  wait "$1"
}

# "1m 05s" for $1 seconds.
elapsed() { printf '%dm %02ds' $(($1 / 60)) $(($1 % 60)); }

# Keeps tabs and printable ASCII only. Text from GitHub (titles, job names, states) is written
# by whoever opened the pull request: nothing else may reach the terminal.
clean() { LC_ALL=C tr -cd '\011\040-\176'; }

# One build of commit $1 as "id<TAB>status<TAB>conclusion" in $tmp/run. $2..: more gh options.
# A run whose jobs were skipped (a pull request without the label) is not a build.
run_query() {
  run_sha="$1"
  shift
  gh_run run list -R "github.com/$repo" --workflow "$workflow" --commit "$run_sha" --event pull_request \
    --limit 20 --json databaseId,status,conclusion "$@" \
    --jq '[.[] | select(.conclusion != "skipped")][0] // empty | [(.databaseId | tostring), .status, (if (.conclusion // "") == "" then "none" else .conclusion end)] | @tsv' \
    >"$tmp/run" 2>/dev/null
}

# Reads the build of commit $1: a finished one if there is one, else the newest run (a newer
# cancelled or unapproved run must not hide a build that exists). Sets run, r_status, r_end;
# run is empty when there is none. Fails when gh does.
build_read_run() {
  run_query "$1" --status success || return 1
  if [ ! -s "$tmp/run" ]; then run_query "$1" || return 1; fi
  IFS="$(printf '\t')" read -r run r_status r_end <<EOT
$(clean <"$tmp/run")
EOT
}

# "ready", "failed (<how>)", "queued" or "running" for the build just read; "no build" without one.
build_state() {
  if ! is_number "$run"; then
    echo "no build"
  elif [ "$r_status" != completed ]; then
    case "$r_status" in
      queued | pending | waiting | requested) echo queued ;;
      *) echo running ;;
    esac
  elif [ "$r_end" = success ]; then
    echo ready
  else
    echo "failed ($r_end)"
  fi
}

# Finds the build of pull request $1's head commit and sets run. A build that is queued or
# running is waited for, with its state on one line; --no-wait says the state and stops.
# With no build, osi adds the label that asks for one and waits for the run to appear.
pr_build() {
  poll="${OSI_POLL:-10}"
  limit="${OSI_WAIT_MAX:-3600}"
  # How long a labelled pull request may show no run before osi gives up.
  start_max="${OSI_START_MAX:-120}"
  is_number "$poll" || poll=10
  is_number "$limit" || limit=3600
  is_number "$start_max" || start_max=120
  began="$(date +%s)"
  waited=0
  did_wait=0
  misses=0
  seen=""
  while :; do
    if ! build_read_run "$pr_sha"; then
      # One failed call (network, rate limit) does not end a wait.
      misses=$((misses + 1))
      if [ "$misses" -ge 3 ] || [ "$did_wait" = 0 ]; then
        spin_clear
        die "could not list the builds of $repo (is gh signed in? gh auth status)"
      fi
      sleep "$poll"
      continue
    fi
    misses=0
    state="$(build_state)"
    url="https://github.com/$repo/actions/runs/$run"
    case "$state" in
      ready)
        spin_clear
        if [ "$did_wait" = 1 ]; then say "Build finished after $(elapsed "$waited")"; fi
        return 0
        ;;
      "no build")
        spin_clear
        if [ "$pr_labelled" != true ]; then
          gh_run pr edit "$1" -R "github.com/$repo" --add-label "$build_label" >/dev/null 2>&1 ||
            die "could not add the label $build_label to pull request $1 (needs write access to $repo): ask a maintainer to add it, then run this again."
          pr_labelled=true
          say "Asked GitHub to build pull request $1 (label $build_label)"
          [ "$no_wait" = 0 ] || die "the build of commit $(short "$pr_sha") is requested: run this again in a few minutes."
        fi
        # A run takes a little while to appear after a label or a push.
        if [ "$no_wait" = 1 ] || [ $(($(date +%s) - began)) -ge "$start_max" ]; then
          die "no build for commit $(short "$pr_sha"): it has not started (gh pr checks $1 -R $repo), it changes only docs, or it is older than 14 days."
        fi
        state=requested
        url="https://github.com/$repo/pull/$1/checks"
        ;;
      "failed (cancelled)")
        spin_clear
        die "the build of commit $(short "$pr_sha") was cancelled (a newer push replaces it: run this again): $url"
        ;;
      failed*)
        spin_clear
        die "the build of commit $(short "$pr_sha") $state: $url"
        ;;
    esac
    [ "$no_wait" = 0 ] || die "the build of commit $(short "$pr_sha") is $state: $url"
    waited=$(($(date +%s) - began))
    if [ "$waited" -ge "$limit" ]; then
      spin_clear
      die "the build is still $state after $(elapsed "$waited"): $url"
    fi
    did_wait=1
    jobs=""
    if [ -t 1 ]; then
      # Which jobs are done, when gh can say.
      is_number "$run" && jobs="$(gh_run run view "$run" -R "github.com/$repo" --json jobs \
        --jq '[.jobs[] | "\(.name) \(if (.conclusion // "") == "" then .status else .conclusion end)"] | join(", ")' 2>/dev/null |
        clean | cut -c 1-80)" || jobs=""
      i=0
      while [ "$i" -lt $((poll * 10)) ]; do
        spin "Build $state${jobs:+ ($jobs)} · $(elapsed $(($(date +%s) - began))) · ^C stops"
        sleep 0.1
        i=$((i + 1))
      done
    else
      # Not a terminal: one line for each change of state.
      if [ "$seen" != "$state" ]; then say "Build $state; waiting. $url"; fi
      seen="$state"
      sleep "$poll"
    fi
  done
}

# Downloads the build of pull request $1 into $dl, after showing whose code it is.
pr_download() {
  pr_read "$1"
  say "Pull request #$1 ($pr_state) by $pr_author"
  say "  head: $pr_sha"
  say "  from: $pr_head"
  if [ "$pr_cross" != false ] || [ "$pr_head" != "$repo" ]; then
    say ""
    say "WARNING: this pull request comes from a fork, not from $repo."
    say "Its build is code that nobody with write access to $repo pushed. Installed, it runs"
    say "with your terminal's permissions, which include Accessibility and Screen Recording."
    [ "$allow_fork" = 1 ] ||
      die "refusing to install a build from a fork. Read the diff first; then: osi install pr $1 --allow-fork"
    printf 'Type the first 7 characters of the head commit to install it: '
    read -r typed || typed=""
    [ "$typed" = "$(printf '%.7s' "$pr_sha")" ] || die "that is not the head commit. Nothing was changed."
  fi

  pr_build "$1"
  gh_run run download "$run" -R "github.com/$repo" -n "$artifact" -D "$dl" 2>"$dl.err" &
  spin_quiet $! "Downloading the build from run $run" || die "could not download the build of run $run: $(clean <"$dl.err")"
  # gh puts a lone artifact straight into the directory; older versions used a subdirectory.
  if [ ! -f "$dl/BUILD" ] && [ -f "$dl/$artifact/BUILD" ]; then dl="$dl/$artifact"; fi
  [ -f "$dl/BUILD" ] && [ -f "$dl/SHA256SUMS" ] && [ -f "$dl/$tarball" ] || die "the build of run $run is incomplete"
}

# Reads and checks $dl/BUILD. Sets b_version, b_commit, b_date.
build_read() {
  b_version="$(get version "$dl/BUILD")"
  b_commit="$(get commit "$dl/BUILD")"
  b_date="$(get date "$dl/BUILD")"
  if ! is_safe "$b_version" || ! is_sha "$b_commit" 40 || ! is_safe "$b_date"; then
    die "the BUILD file is not valid. Nothing was changed."
  fi
}

# Writes state file $1 with one key=value per line from the remaining arguments, by rename.
write_state() {
  state_file="$1"
  shift
  printf '%s\n' "$@" >"$state_file.new"
  mv -f "$state_file.new" "$state_file"
}

# True when the app osi installed is running. The app writes its pid and program path to
# `running` in its folder; a stale file (pid gone, or reused by another program) does not count,
# nor does a subcommand (`ottospace ctl`), which writes none. OSI_PS names another program that
# prints a pid's executable, for tests.
is_running() {
  run_file="$(dirname "$state_dir")/running"
  [ -f "$run_file" ] && [ ! -L "$run_file" ] && [ "$(wc -c <"$run_file")" -le 4096 ] || return 1
  run_pid="$(sed -n 1p "$run_file")"
  run_program="$(sed -n 2p "$run_file")"
  is_number "$run_pid" || return 1
  [ "$run_program" = "$(resolved "$cmd")" ] ||
    { [ -n "$app" ] && [ "$run_program" = "$(resolved "$app/Contents/MacOS/ottospace")" ]; } || return 1
  kill -0 "$run_pid" 2>/dev/null || return 1
  if [ -n "${OSI_PS:-}" ]; then
    exe="$("$OSI_PS" "$run_pid" 2>/dev/null)" || return 1
  else
    # The first `txt` file of a process is its executable, resolved (`ps` shows argv[0]).
    exe="$(lsof -a -p "$run_pid" -d txt -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1)"
  fi
  [ "$exe" = "$run_program" ]
}

# Path $1 with its folder's symlinks resolved, as the app records it (`~/.local/bin` may be one).
resolved() { printf '%s/%s' "$(cd -P "$(dirname "$1")" 2>/dev/null && pwd)" "$(basename "$1")"; }

# After a swap: $was_running, asked before it.
note_running() {
  if [ "$was_running" = 1 ]; then say "ottospace is running the old build: quit it and start it again."; fi
}

# Says when main has a newer commit than the build installed, commit $1. Silent when the lookup
# fails: it never fails an install. OSI_MAIN_URL names another source, for tests.
note_behind() {
  main_url="${OSI_MAIN_URL:-https://api.github.com/repos/$repo/commits/main}"
  case "$main_url" in
    https://*) proto='=https' ;;
    file://*) proto='=file' ;;
    *) return 0 ;;
  esac
  tip="$(curl -fsS --proto "$proto" --tlsv1.2 --max-time 5 -H 'Accept: application/vnd.github.sha' "$main_url" 2>/dev/null |
    head -c 40)" || return 0
  if is_sha "$tip" 40 && [ "$tip" != "$1" ]; then
    say "main has newer commits ($(printf '%.7s' "$tip")) than this build."
  fi
}

# Installs channel $1 (main, stable, version, pr) with ref $2 (a tag or a pull request number).
install_build() {
  channel="$1"
  ref="$2"

  # Never replace an `ottospace` command osi has no record of.
  if { [ -e "$cmd" ] || [ -L "$cmd" ]; } && [ ! -f "$state_dir/current" ] && [ "$force" != 1 ]; then
    die "$cmd exists and osi did not install it. Remove it, or run again with --force."
  fi
  # The same for the app: one built by hand with scripts/bundle.sh is not osi's to replace.
  owned=0
  if app_owned; then owned=1; fi
  if [ "$want_app" = 1 ] && { [ -e "$app" ] || [ -L "$app" ]; } && [ "$owned" != 1 ] && [ "$force" != 1 ]; then
    die "$app exists and osi did not install it. Remove it, or run again with --force."
  fi

  if [ "$channel" = pr ]; then
    pr_download "$ref"
  else
    release_base "$channel" "$ref"
    # Behind a spinner; what went wrong is said after it.
    (
      fetch "$base/BUILD" "$dl/BUILD" || die "no build at $base (download failed)"
      fetch "$base/SHA256SUMS" "$dl/SHA256SUMS" || die "download failed: $base/SHA256SUMS"
      fetch "$base/$tarball" "$dl/$tarball" || die "download failed: $base/$tarball"
      if [ "$want_app" = 1 ]; then
        fetch "$base/$appzip" "$dl/$appzip" || die "download failed: $base/$appzip"
      fi
    ) 2>"$tmp/fetch.err" &
    if ! spin_quiet $! "Downloading $(describe "$channel" "$ref")"; then
      cat "$tmp/fetch.err" >&2
      exit 1
    fi
  fi

  # Everything is checked before anything is changed.
  verify BUILD
  verify "$tarball"
  build_read
  if [ "$channel" = pr ] && [ "$b_commit" != "$pr_sha" ]; then
    die "the build is of commit $(short "$b_commit"), not the pull request's head. Nothing was changed."
  fi
  mkdir "$tmp/bin"
  tar -xzf "$dl/$tarball" -C "$tmp/bin" ottospace || die "the download holds no ottospace binary"
  [ -f "$tmp/bin/ottospace" ] && [ ! -L "$tmp/bin/ottospace" ] && [ -s "$tmp/bin/ottospace" ] ||
    die "the download holds no ottospace binary"
  # The osi this build carries, if any (older builds carry none). Same checksum as the binary.
  tar -xzf "$dl/$tarball" -C "$tmp/bin" osi 2>/dev/null || true
  if [ "$want_app" = 1 ]; then
    [ -f "$dl/$appzip" ] || die "this build has no $appzip"
    verify "$appzip"
    ditto -x -k "$dl/$appzip" "$tmp/app"
    [ -x "$tmp/app/ottospace.app/Contents/MacOS/ottospace" ] || die "the zip holds no ottospace.app"
    codesign --verify --deep --strict "$tmp/app/ottospace.app" 2>/dev/null || die "the app's signature does not verify"
  fi

  mkdir -p "$bin_dir" "$state_dir"
  # Stage beside the destination: the swap is then one rename, and a running ottospace keeps
  # its old file. Writing over the file in place would get the running process killed.
  staged="$bin_dir/.ottospace.new.$$"
  cp "$tmp/bin/ottospace" "$staged"
  chmod 755 "$staged"
  if [ "$want_app" = 1 ]; then
    mkdir -p "$app_dir"
    staged_app="$app_dir/.ottospace.app.new.$$"
    rm -rf "$staged_app"
    ditto "$tmp/app/ottospace.app" "$staged_app"
  fi
  # A copy of the build being replaced, for `osi rollback`. It gets its name after the swap.
  keep=0
  if [ -f "$cmd" ] && [ -f "$state_dir/current" ]; then
    cp -p "$cmd" "$state_dir/previous.bin.new"
    cp "$state_dir/current" "$state_dir/previous.new"
    keep=1
  fi

  # Asked before the swap: once a running app is moved aside, its executable's path changes.
  was_running=0
  if is_running; then was_running=1; fi
  # Everything is staged: from here on only renames. A failure puts the old app back.
  if [ "$want_app" = 1 ]; then
    if [ -e "$app" ] || [ -L "$app" ]; then
      aside_app="$app_dir/.ottospace.app.old.$$"
      rm -rf "$aside_app"
      mv "$app" "$aside_app"
    fi
    mv "$staged_app" "$app"
    staged_app=""
  fi
  if ! mv -f "$staged" "$cmd"; then
    if [ "$want_app" = 1 ]; then rm -rf "$app"; fi
    die "could not write $cmd. Nothing was changed."
  fi
  staged=""

  # The swap is done: now the records.
  if [ "$keep" = 1 ]; then
    mv -f "$state_dir/previous.bin.new" "$state_dir/previous.bin"
    mv -f "$state_dir/previous.new" "$state_dir/previous"
  fi
  # previous.app is kept only while it is the app of the previous build.
  rm -rf "$state_dir/previous.app" "$state_dir/previous.app.record"
  if [ "$want_app" = 1 ]; then
    if [ -n "$aside_app" ] && [ "$owned" = 1 ] && [ "$keep" = 1 ]; then
      mv "$aside_app" "$state_dir/previous.app"
      cp "$state_dir/app" "$state_dir/previous.app.record"
    elif [ -n "$aside_app" ]; then
      # Not osi's (--force), or no previous build to pair it with.
      rm -rf "$aside_app"
    fi
    aside_app=""
    write_state "$state_dir/app" "path=$app" "version=$b_version" "commit=$b_commit"
  fi
  # A first install says how to run ottospace; later ones do not.
  first=0
  if [ ! -f "$state_dir/current" ]; then first=1; fi
  write_state "$state_dir/current" "channel=$channel" "ref=$ref" "version=$b_version" "commit=$b_commit" \
    "date=$b_date" "binary_sha256=$(sha256_of "$cmd")" "installed=$(now)"

  say "Installed ottospace $b_version ($(printf '%.7s' "$b_commit")) from $(describe "$channel" "$ref")"
  if [ "$want_app" = 1 ]; then
    if [ "$owned" != 1 ]; then
      say "The app is a new identity to macOS with every build: grant it Accessibility and Screen Recording after each install."
    fi
  elif [ "$owned" = 1 ] && [ -e "$app" ]; then
    say "$app is build $(short "$(get commit "$state_dir/app")") and was left as it is (add --app to update it)."
  fi
  case ":$user_path:" in
    *":$bin_dir:"*) ;;
    *) say "$bin_dir is not on your PATH. Add it, e.g. in ~/.zshrc: export PATH=\"$bin_dir:\$PATH\"" ;;
  esac
  if [ "$first" = 1 ]; then
    say "Run \`ottospace\` from a terminal: it uses that terminal's Accessibility and Screen Recording permissions."
  fi
  if [ "$channel" = main ]; then note_behind "$b_commit"; fi
  note_running
  update_self "$tmp/bin/osi"
}

# The OSI_VERSION in file $1; 0 when it has none (an osi from before the number).
osi_version_of() {
  v="$(sed -n 's/^OSI_VERSION=\([0-9][0-9]*\)$/\1/p' "$1" 2>/dev/null | head -n 1)"
  echo "${v:-0}"
}

# Replaces the installed osi with $1, the osi a build carries, when $1 is a newer osi and the
# installed file is osi's. This run goes on with the old code; the next one uses the new.
update_self() {
  dest="$bin_dir/osi"
  [ -f "$1" ] && [ ! -L "$1" ] && [ -f "$dest" ] && [ ! -L "$dest" ] || return 0
  [ "$(sed -n 2p "$dest")" = "$marker" ] || return 0
  [ "$(sed -n 1p "$1")" = "#!/bin/sh" ] && [ "$(sed -n 2p "$1")" = "$marker" ] && sh -n "$1" || return 0
  [ "$(osi_version_of "$1")" -gt "$(osi_version_of "$dest")" ] || return 0
  staged="$bin_dir/.osi.new.$$"
  cp "$1" "$staged"
  chmod "$(stat -f %Lp "$dest")" "$staged"
  if mv -f "$staged" "$dest"; then
    say "Updated osi too."
  else
    say "Could not update osi: run osi self-update."
  fi
  staged=""
}

describe() {
  case "$1" in
    main) printf 'main' ;;
    stable) printf 'stable (latest release)' ;;
    pr) printf 'pull request #%s' "$2" ;;
    *) printf '%s' "$2" ;;
  esac
}

# One line for the build in state file $1.
state_line() {
  printf '%s  %s  commit %s  %s' "$(describe "$(get channel "$1")" "$(get ref "$1")")" "$(get version "$1")" \
    "$(short "$(get commit "$1")")" "$(get date "$1")"
}

cmd_install() {
  want_app=0
  force=0
  allow_fork=0
  no_wait=0
  channel=""
  ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --app) want_app=1 ;;
      --force) force=1 ;;
      --allow-fork) allow_fork=1 ;;
      --no-wait) no_wait=1 ;;
      -*) die "unknown option: $1" ;;
      main | stable)
        [ -z "$channel" ] || die "name one build to install"
        channel="$1"
        ref="$1"
        ;;
      pr)
        [ -z "$channel" ] || die "name one build to install"
        channel="pr"
        ref="${2:-}"
        ref="${ref#\#}"
        is_number "$ref" || die "usage: osi install pr <number>"
        shift
        ;;
      v[0-9]*)
        [ -z "$channel" ] || die "name one build to install"
        is_safe "$1" || die "bad version '$1' (expected vX.Y.Z)"
        channel=version
        ref="$1"
        ;;
      *) die "unknown build '$1' (expected main, stable, pr <number> or vX.Y.Z)" ;;
    esac
    shift
  done
  [ -n "$channel" ] || die "usage: osi install main | stable | pr <number> | vX.Y.Z"
  if [ "$channel" = main ]; then ref="$main_tag"; fi
  if [ "$channel" = stable ]; then ref=latest; fi
  setup
  install_build "$channel" "$ref"
}

# The builds that can be installed, and which one is.
cmd_list() {
  setup
  have="$(get commit "$state_dir/current")"
  mark() { if [ -n "$have" ] && [ "$(short "$1")" = "$(short "$have")" ]; then printf '  (installed)'; fi; }

  release_base main
  if fetch "$base/BUILD" "$tmp/main.BUILD" 2>/dev/null; then
    m_commit="$(get commit "$tmp/main.BUILD")"
    is_sha "$m_commit" 40 || m_commit=""
  else
    m_commit=""
  fi
  if [ -n "$m_commit" ]; then
    say "main      $(printf '%.7s' "$m_commit")  ready$(mark "$m_commit")"
    say "          osi install main"
  else
    say "main      no build published"
  fi

  gh_cmd="${OSI_GH:-$(PATH="$user_path" command -v gh || true)}"
  if [ -z "$gh_cmd" ]; then
    say ""
    say "Pull request builds need the GitHub CLI: https://cli.github.com (then: gh auth login)"
    return 0
  fi
  # One line each: number, head commit, fork or not, labelled or not, title. A title cannot write
  # to the terminal.
  gh_run pr list -R "github.com/$repo" --state open --limit 51 \
    --json number,headRefOid,isCrossRepository,labels,title \
    --jq '.[] | [(.number | tostring), .headRefOid, (.isCrossRepository | tostring), '"$has_label"', (.title | gsub("[\t\n\r]"; " "))] | @tsv' \
    >"$tmp/prs" 2>/dev/null &
  spin_quiet $! "Reading open pull requests" || die "could not list the pull requests of $repo (is gh signed in? gh auth status)"
  [ -s "$tmp/prs" ] || {
    say ""
    say "No open pull requests."
    return 0
  }
  say ""
  listed=0
  while IFS="$(printf '\t')" read -r number sha cross labelled title; do
    is_number "$number" || continue
    is_sha "$sha" 40 || continue
    title="$(printf '%s' "$title" | clean | cut -c 1-60)"
    listed=$((listed + 1))
    if [ "$listed" -gt 50 ]; then
      say "…and more: gh pr list -R $repo"
      break
    fi
    spin "pr $number"
    if build_read_run "$sha"; then state="$(build_state)"; else state="unknown (gh failed)"; fi
    spin_clear
    # Builds are made on request: install asks for one.
    if [ "$state" = "no build" ] && [ "$labelled" != true ]; then state="no build (to build it: osi install pr $number)"; fi
    if [ "$cross" != false ]; then state="$state, from a fork"; fi
    say "$(printf 'pr %-6s %.7s  %s' "$number" "$sha" "$state")$(mark "$sha")"
    say "          $title"
  done <"$tmp/prs"
  say ""
  say "Install one: osi install pr <n>. A build that is missing is requested, and waited for."
}

# osi's own version, and the build it installed.
cmd_version() {
  setup
  say "osi $OSI_VERSION"
  if [ -f "$state_dir/current" ]; then say "ottospace $(state_line "$state_dir/current")"; fi
}

cmd_current() {
  setup
  [ -f "$state_dir/current" ] || die "nothing is installed by osi (osi install main)"
  say "ottospace $(state_line "$state_dir/current")"
  say "  installed: $(get installed "$state_dir/current")"
  say "  osi:       version $OSI_VERSION"
  say "  command:   $cmd"
  if [ ! -f "$cmd" ]; then
    say "             missing"
  elif [ "$(sha256_of "$cmd")" != "$(get binary_sha256 "$state_dir/current")" ]; then
    say "             changed since osi installed it"
  fi
  if app_owned; then
    say "  app:       $app  commit $(short "$(get commit "$state_dir/app")")"
  fi
  if [ -f "$state_dir/previous" ] && [ -f "$state_dir/previous.bin" ]; then
    say "  previous:  $(state_line "$state_dir/previous")  (osi rollback)"
  fi
}

cmd_update() {
  check=0
  update_no_wait=0
  for arg in "$@"; do
    case "$arg" in
      --check) check=1 ;;
      --no-wait) update_no_wait=1 ;;
      *) die "unknown option: $arg" ;;
    esac
  done
  setup
  [ -f "$state_dir/current" ] || die "nothing is installed by osi (osi install main)"
  channel="$(get channel "$state_dir/current")"
  ref="$(get ref "$state_dir/current")"
  have="$(get commit "$state_dir/current")"
  # An app osi installed is kept at the same build as the command.
  want_app=0
  if app_owned; then want_app=1; fi
  force=0
  allow_fork=0
  no_wait="$update_no_wait"

  case "$channel" in
    main | stable)
      release_base "$channel" "$ref"
      fetch "$base/BUILD" "$tmp/BUILD.latest" || die "no build at $base (download failed)"
      latest="$(get commit "$tmp/BUILD.latest")"
      is_sha "$latest" 40 || die "the BUILD file is not valid"
      ;;
    pr)
      is_number "$ref" || die "the state file is damaged: $state_dir/current"
      pr_read "$ref"
      latest="$pr_sha"
      if [ "$pr_state" = MERGED ]; then say "Pull request #$ref is merged: osi install main"; fi
      ;;
    version)
      say "Pinned to $ref. Follow a channel instead: osi install main, or osi install stable."
      return 0
      ;;
    *) die "the state file is damaged: $state_dir/current" ;;
  esac

  if [ "$latest" = "$have" ]; then
    say "Up to date: $(state_line "$state_dir/current")"
    if [ "$channel" = main ]; then note_behind "$have"; fi
    return 0
  fi
  if [ "$check" = 1 ]; then
    say "$(describe "$channel" "$ref") is at $(short "$latest"); installed is $(short "$have")."
    say "Run: osi update"
    return 0
  fi
  # An update of a fork's pull request asks again: its head is new code.
  if [ "$channel" = pr ] && { [ "$pr_cross" != false ] || [ "$pr_head" != "$repo" ]; }; then allow_fork=1; fi
  install_build "$channel" "$ref"
}

cmd_rollback() {
  setup
  [ -f "$state_dir/previous" ] && [ -f "$state_dir/previous.bin" ] || die "there is no previous build to go back to"
  [ -f "$state_dir/current" ] || die "the state file is missing: $state_dir/current"
  was_running=0
  if is_running; then was_running=1; fi
  mkdir -p "$bin_dir"
  staged="$bin_dir/.ottospace.new.$$"
  cp -p "$state_dir/previous.bin" "$staged"
  chmod 755 "$staged"
  # The build being left becomes the previous one, so a second rollback undoes the first.
  keep=0
  if [ -f "$cmd" ]; then
    cp -p "$cmd" "$state_dir/previous.bin.new"
    keep=1
  fi
  mv -f "$staged" "$cmd"
  staged=""
  cp "$state_dir/current" "$tmp/was-current"
  mv -f "$state_dir/previous" "$state_dir/current"
  if [ "$keep" = 1 ]; then
    mv -f "$state_dir/previous.bin.new" "$state_dir/previous.bin"
    cp "$tmp/was-current" "$state_dir/previous.new"
    mv -f "$state_dir/previous.new" "$state_dir/previous"
  else
    # The command was missing: there is no build to come back to.
    rm -f "$state_dir/previous.bin"
  fi

  # The app follows only when the kept app is of the build rolled back to.
  target_commit="$(get commit "$state_dir/current")"
  if app_owned && [ -d "$state_dir/previous.app" ] &&
    [ "$(get commit "$state_dir/previous.app.record")" = "$target_commit" ]; then
    if [ -e "$app" ]; then
      aside_app="$app_dir/.ottospace.app.old.$$"
      rm -rf "$aside_app"
      mv "$app" "$aside_app"
    fi
    mv "$state_dir/previous.app" "$app"
    cp "$state_dir/app" "$tmp/app-was-current"
    mv -f "$state_dir/previous.app.record" "$state_dir/app"
    if [ -n "$aside_app" ] && [ "$keep" = 1 ]; then
      mv "$aside_app" "$state_dir/previous.app"
      cp "$tmp/app-was-current" "$state_dir/previous.app.record"
    elif [ -n "$aside_app" ]; then
      rm -rf "$aside_app"
    fi
    aside_app=""
  else
    rm -rf "$state_dir/previous.app" "$state_dir/previous.app.record"
    if app_owned && [ "$(get commit "$state_dir/app")" != "$target_commit" ]; then
      say "$app is build $(short "$(get commit "$state_dir/app")") and was left as it is."
    fi
  fi

  say "Rolled back to ottospace $(state_line "$state_dir/current")"
  say "Undo: osi rollback"
  note_running
}

cmd_uninstall() {
  setup
  [ -f "$state_dir/current" ] || die "nothing is installed by osi"
  was_running=0
  if is_running; then was_running=1; fi
  rm -f "$cmd"
  say "Removed $cmd"
  if app_owned && [ -d "$app" ]; then
    rm -rf "$app"
    say "Removed $app"
  fi
  rm -rf "$state_dir"
  say "Removed $state_dir"
  if [ -f "$bin_dir/osi" ] && [ "$(sed -n 2p "$bin_dir/osi")" = "$marker" ]; then
    rm -f "$bin_dir/osi"
    say "Removed $bin_dir/osi"
  fi
  say "Kept: settings and tasks in $(dirname "$state_dir")."
  if [ "$was_running" = 1 ]; then
    say "ottospace is still running. Quit it: use its window, or the control socket request {\"cmd\":\"quit\"}."
  fi
}

cmd_self_update() {
  setup
  dest="$bin_dir/osi"
  if { [ -e "$dest" ] || [ -L "$dest" ]; } && [ "$(sed -n 2p "$dest")" != "$marker" ]; then
    die "$dest exists and is not osi. Remove it and run again."
  fi
  fetch "$self_url" "$tmp/osi" || die "download failed: $self_url"
  if [ "$(sed -n 1p "$tmp/osi")" != "#!/bin/sh" ] || [ "$(sed -n 2p "$tmp/osi")" != "$marker" ] || ! sh -n "$tmp/osi"; then
    die "the download is not osi. Nothing was changed."
  fi
  mkdir -p "$bin_dir"
  staged="$bin_dir/.osi.new.$$"
  cp "$tmp/osi" "$staged"
  chmod 755 "$staged"
  mv -f "$staged" "$dest"
  staged=""
  say "Updated $dest"
}

main() {
  command="${1:-}"
  if [ $# -gt 0 ]; then shift; fi
  case "$command" in
    install) cmd_install "$@" ;;
    list) cmd_list ;;
    current) cmd_current ;;
    update) cmd_update "$@" ;;
    rollback) cmd_rollback ;;
    uninstall) cmd_uninstall ;;
    self-update) cmd_self_update ;;
    help | -h | --help) usage ;;
    --version | version) cmd_version ;;
    "")
      usage >&2
      exit 2
      ;;
    *)
      printf 'osi: unknown command: %s\n\n' "$command" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"

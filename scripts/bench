#!/usr/bin/env python3
"""Benchmarks of ottospace on a private test instance: startup, memory, CPU.

  scripts/bench [--bin PATH] [--release] [--runs N] [--out DIR]
  scripts/bench --compare <base-ref> [--bin-before PATH --bin-after PATH] [--runs N] [--out DIR]

Each instance is scripts/shot's (`Instance`): OTTOSPACE_E2E, its home and socket in a fresh
temp folder, `/bin/sh` terminals, no apps, no repositories or sessions of the user's.

  startup_warm_ms      process start to: the socket answers and a frame is drawn (`frame.number`
                       > 0). The binary was run before; one unmeasured launch first.
  startup_cold_ms      the same, the first launch of a fresh copy (`cp -c`) of the binary at a new
                       path: none of its pages in the file cache, no launch closure for it. The
                       system's libraries stay cached: dropping those needs root (`purge`).
  startup_sessions_ms  the same, with a home of 50 made-up Claude Code and Codex sessions in 5
                       repositories, 12 tasks and a saved layout of 3 tabs.
  sessions_read_ms     with that home, process start to its sessions listed (Tasks, Elsewhere, open).
  rss_idle_mb, footprint_idle_mb    resident size and phys_footprint, 5 s after start.
  rss_8_terms_mb, footprint_8_terms_mb   after 8 terminals, each with 5000 lines of scrollback.
  cpu_idle_pct         the process's CPU over 30 s with nothing moving (100 = one core).
  frames_idle, dial_frames_idle     frames drawn and dial frames over those 30 s: 0 at rest.
  wakeups_idle_per_s   the process's wakeups a second over those 30 s.
  ticks_idle           runs of the app's tick over those 30 s (`counts.ticks`): a second of each
                       frame after the first request, then about one a second.
  cpu_stream_pct       its CPU over 10 s while one terminal prints about 2500 lines a second.
  cpu_hidden_stream_pct, frames_hidden_stream   the same with that terminal's tab not on show: its CPU
                       and the frames drawn (nothing on screen changes).
  city_2000_ms, city_20000_ms   with `code_city` on, a repository's tab emptied (its terminal
                       closed) to its code city's picture in the state, for a made-up tree of
                       2,000 and 20,000 files (scripts/shot's): read, render and painted.
  motion               the code city moving, at CI's window (1024×674), 2,000 and 20,000 files:
                       while its first picture rises, and while the user's left drag turns it
                       (120 moves of 3 points). Per frame (the trace's `frame`: render to paint
                       on the main thread) the median and p95 time and how many took over
                       16.7 ms; the frames' spacing; per picture made (`city_picture`) the scene,
                       the GPU, the copy out of its read buffer and the image made of it.

  spin                 the code city turned once round by the Developer command's spin (`city_spin`: a
                       step a frame, as a steady drag), at CI's window, for a made-up repository of
                       9,500 files in 900 folders (`shot.made_up_repo`; `--city-large`: also 50,000,
                       60,000, 200,000 and 600,000 files, folders in proportion, empty). From the app:
                       each frame's time from the one before (mean, p50, p95, p99, max, over 16.7 and
                       33 ms), frames that showed the picture the frame before did, and a new
                       picture's wait from made to painted; from the trace, per picture: boxes,
                       textures, GPU, copy out; per paint: the picture's upload into GPUI's atlas.

  typing               the Developer command's timed typing (`typing_time`) at CI's window: 250 made-up
                       keys into a throwaway `cat` (idle), the same beside a pane printing without end
                       (busy), and into a made-up full-screen program (full). Per stage (key event to
                       pty write, to echo parsed, to taken by the main thread, to painted) p50 / p95 /
                       p99 / max, and the app's own share (key to write plus parsed to taken). The
                       display's refresh sets a floor the app cannot go under (a frame: 16.7 ms at
                       60 Hz, 13.3 at 75, 8.3 at 120); the app's share must stay under one 120 Hz frame.

Startups: median and p90 of --runs launches (cold: --cold-runs). With --compare, both sides
run alternately, so drift of the machine falls on both; the deltas are printed and the exit
status is 1 when one passes a threshold (THRESHOLDS below), 2 when the bench itself failed.
Writes <out>/bench.json and <out>/bench.md (also printed).
"""

import argparse
import ctypes
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import statistics
import subprocess
import sys
import tempfile
import time
import traceback

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
SHOTS = os.path.join(HERE, "shots")

# The private instance, the builds and the base tree are scripts/shot's (no __pycache__ of it left).
sys.dont_write_bytecode = True
_loader = importlib.machinery.SourceFileLoader("shot", os.path.join(HERE, "shot"))
_spec = importlib.util.spec_from_loader("shot", _loader)
shot = importlib.util.module_from_spec(_spec)
_loader.exec_module(shot)
Failed, say = shot.Failed, shot.say

# A start is timed by these waits: look every 5 ms, not 50.
shot.Instance.poll = 0.005

IDLE_S, STREAM_S, TERMS, SCROLLBACK = 30, 10, 8, 5000

# A regression past these turns the CI job red: (metric, relative rise, absolute rise, floor). All
# must be passed, so a small number's noise does not: e.g. idle CPU fails above 2% of a core and
# a point more than the base, whatever its relative rise.
THRESHOLDS = [
    ("startup_warm_ms", 0.20, 50, 0),
    ("startup_cold_ms", 0.20, 50, 0),
    ("startup_sessions_ms", 0.20, 50, 0),
    ("rss_idle_mb", 0.25, 10, 0),
    ("rss_8_terms_mb", 0.25, 10, 0),
    ("cpu_idle_pct", None, 1.0, 2.0),
    ("city_2000_ms", 0.25, 100, 0),
    ("city_20000_ms", 0.25, 150, 0),
    # A turn of 9,500 files: not its frames' p99 nor those over 33 ms: an A/A run of one build swung them 30% and more.
    # Its repeated frames and its pictures' wait held within a few percent.
    ("spin_9500_wait_p50_ms", 0.25, 3.0, 0),
    # Frames that showed the picture before (of 240): the turn standing still on screen.
    ("spin_9500_repeats", None, 24, 24),
    # Key to painted echo: the display's frame is most of it, so a frame's rise.
    ("typing_total_p99_ms", 0.25, 4.0, 0),
    ("typing_busy_total_p99_ms", 0.25, 4.0, 0),
    ("typing_full_total_p99_ms", 0.25, 4.0, 0),
]
# Past these, whatever the base: the app's own share of a key's latency (p99, ms) stays under one
# 120 Hz frame (`ottospace_core::typing::APP_BUDGET_MS`).
CEILINGS = [("typing_app_p99_ms", 8.3), ("typing_busy_app_p99_ms", 8.3), ("typing_full_app_p99_ms", 8.3)]
LIVE_REPEATS = 12
LIMITS = ("startup median +20% and +50 ms; RSS +25% and +10 MB; idle CPU above 2% of a core and +1 point; "
          "code city +25% and +100 ms (20,000 files: +150 ms); "
          "a spin of 9,500 files: a new picture's wait p50 +25% and +3 ms, repeated frames above 24 and +24; "
          "a spin the base made and this side did not; typing's key to screen p99 +25% and +4 ms (each run); "
          "the app's own share of a key (p99) above 8.3 ms on this side; typing the base timed and this side did not.")


# proc_pid_rusage(2): CPU times, wakeups, resident size and phys_footprint of a pid we started.
class RusageV2(ctypes.Structure):
    _fields_ = [("uuid", ctypes.c_uint8 * 16)] + [
        (name, ctypes.c_uint64)
        for name in [
            "user_time", "system_time", "pkg_idle_wkups", "interrupt_wkups", "pageins", "wired_size",
            "resident_size", "phys_footprint", "proc_start_abstime", "proc_exit_abstime", "child_user_time",
            "child_system_time", "child_pkg_idle_wkups", "child_interrupt_wkups", "child_pageins",
            "child_elapsed_abstime", "diskio_bytesread", "diskio_byteswritten",
        ]
    ]


class Timebase(ctypes.Structure):
    _fields_ = [("numer", ctypes.c_uint32), ("denom", ctypes.c_uint32)]


LIBC = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
_tb = Timebase()
LIBC.mach_timebase_info(ctypes.byref(_tb))
# The CPU times are in Mach time units (on Apple silicon not nanoseconds).
NS_PER_TICK = _tb.numer / _tb.denom


def usage(pid):
    info = RusageV2()
    if LIBC.proc_pid_rusage(pid, 2, ctypes.byref(info)) != 0:
        raise Failed(f"proc_pid_rusage({pid}) failed")
    return {
        "cpu_s": (info.user_time + info.system_time) * NS_PER_TICK / 1e9,
        "wakeups": info.pkg_idle_wkups + info.interrupt_wkups,
        "rss_mb": info.resident_size / 2**20,
        "footprint_mb": info.phys_footprint / 2**20,
    }


def cpu_over(inst, seconds):
    """The process's CPU (percent of one core), wakeups a second and frames over `seconds`."""
    s0, u0, t0 = inst.state(), usage(inst.proc.pid), time.perf_counter()
    time.sleep(seconds)
    u1, t1 = usage(inst.proc.pid), time.perf_counter()
    s1 = inst.state()
    wall = t1 - t0
    return {
        "cpu_pct": 100 * (u1["cpu_s"] - u0["cpu_s"]) / wall,
        "wakeups_per_s": (u1["wakeups"] - u0["wakeups"]) / wall,
        "frames": s1["frame"]["number"] - s0["frame"]["number"],
        "dial_frames": s1["counts"]["dial_frames"] - s0["counts"]["dial_frames"],
        # Runs of the app's tick: none counted by a build before `counts.ticks`.
        "ticks": s1["counts"]["ticks"] - s0["counts"]["ticks"] if "ticks" in s0["counts"] else None,
    }


# ---------------------------------------------------------------------------------- fixtures


def slug(path):
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def make_fixture(root):
    """A home with sessions, tasks and settings, all made up; returns the env for an instance.
    The layout is added by `prime`. Sessions are written from scripts/shots' own fixtures."""
    root = os.path.realpath(root)  # the app resolves the repositories: /tmp is /private/tmp
    with open(os.path.join(SHOTS, "restart/sessions/claude/projects/_slug-repos-app/"
                                  "8f14e45f-ceea-467f-a8d3-0242ac130009.jsonl")) as f:
        claude_tpl = f.read()
    codex_dir = os.path.join(SHOTS, "tasks/codex/sessions/2026/11/12")
    codex_name = next(n for n in sorted(os.listdir(codex_dir)) if "c0de0001" in n)
    with open(os.path.join(codex_dir, codex_name)) as f:
        codex_tpl = f.read()
    repos = [os.path.join(root, "repos", name) for name in ["app", "api", "site", "docs", "cli"]]
    home = os.path.join(root, "home")
    os.makedirs(os.path.join(home, "tasks"))
    index = []
    for r, repo in enumerate(repos):
        os.makedirs(os.path.join(repo, ".git"))
        with open(os.path.join(repo, ".git", "HEAD"), "w") as f:
            f.write("ref: refs/heads/main\n")
        project = os.path.join(root, "claude", "projects", slug(repo))
        os.makedirs(project)
        for n in range(5):
            sid = f"8f14e45f-ceea-467f-a8d3-{r:06d}{n:06d}"
            with open(os.path.join(project, sid + ".jsonl"), "w") as f:
                f.write(claude_tpl.replace("8f14e45f-ceea-467f-a8d3-0242ac130009", sid).replace("{ROOT}/repos/app", repo))
            cid = f"c0de{r:02d}{n:02d}-0000-4000-8000-{r:06d}{n:06d}"
            day = os.path.join(root, "codex", "sessions", "2026", "11", f"{10 + r:02d}")
            os.makedirs(day, exist_ok=True)
            stamp = f"2026-11-{10 + r:02d}T09-{n:02d}-00"
            text = codex_tpl.replace("c0de0001-0000-4000-8000-000000000001", cid).replace("{ROOT}/repos/app", repo)
            with open(os.path.join(day, f"rollout-{stamp}-{cid}.jsonl"), "w") as f:
                f.write(text)
            index.append({"id": cid, "thread_name": f"Made-up thread {r}.{n}", "updated_at": f"2026-11-{10 + r:02d}T09:{n:02d}:01Z"})
    with open(os.path.join(root, "codex", "session_index.jsonl"), "w") as f:
        f.writelines(json.dumps(line) + "\n" for line in index)
    for t in range(1, 13):
        task = {"id": t, "title": f"made-up task {t}", "state": ["needs_you", "running", "parked", "done"][t % 4],
                "priority": 1 + t % 3, "repo": repos[t % 5], "created": 1794800000000 + t * 1000, "colour": t % 6}
        if t <= 5:
            # Its repository's first Claude session.
            task["session"] = {"runner": "claude", "id": f"8f14e45f-ceea-467f-a8d3-{t % 5:06d}000000", "state": "done"}
        with open(os.path.join(home, "tasks", f"{t}.json"), "w") as f:
            json.dump(task, f)
    settings = {"repos": repos, "sessions": True, "restore_layout": True,
                "session_dirs": {"claude": [os.path.join(root, "claude")], "codex": os.path.join(root, "codex")}}
    with open(os.path.join(home, "settings.json"), "w") as f:
        json.dump(settings, f)
    return home


def prime(binary, home):
    """Runs the app once on `home` to leave a saved layout: 3 tabs, 2 terminals each."""
    inst = shot.Instance(binary, None, {"OTTOSPACE_HOME": home})
    try:
        for tab in range(3):
            if tab:
                inst.ok({"cmd": "new_tab"})
            for _ in range(2):
                inst.ok({"cmd": "split", "axis": "right"})
        inst.settle()
        inst.wait("layout.json", lambda: os.path.exists(os.path.join(home, "layout.json")), timeout=10)
        time.sleep(1.5)  # written a second after the last change
    finally:
        inst.close()


# ---------------------------------------------------------------------------------- runs


def launch(binary, env=None):
    inst = shot.Instance(binary, None, env or {})
    # Started: later waits look less often, so each full state they ask for loads the app less.
    inst.poll = 0.02
    return inst


def startup(binary, env=None, sessions=False):
    inst = launch(binary, env)
    try:
        row = {"ms": inst.drawn * 1000, "socket_ms": inst.answered * 1000}
        if sessions:
            # Closed, the Tasks section reads only the tasks' sessions: open it on Elsewhere, of any age.
            # Both requests toggle: sent only when it is not open already.
            s = inst.state()
            if s["state"]["sidebar"] != "tasks":
                inst.ok({"cmd": "section", "section": "tasks"})
            if s["sessions_bar"]["collapsed"]:
                inst.ok({"cmd": "task_group", "heading": "sessions"})
            inst.ok({"cmd": "sessions_range", "range": "all"})
            # One read takes them all in; those a task follows are not listed (46 today).
            listed = lambda: (shot.path_get(inst.state(), "sessions_bar.total") or 0) >= 40
            inst.wait("the sessions listed", listed, timeout=30)
            row["sessions_ms"] = (time.perf_counter() - inst.started) * 1000
        return row
    finally:
        inst.close()


def long_run(binary):
    """One instance: memory at idle, CPU at idle, memory with 8 terminals, CPU while one streams."""
    inst = launch(binary)
    out = {}
    try:
        time.sleep(5)
        u = usage(inst.proc.pid)
        out["rss_idle_mb"], out["footprint_idle_mb"] = u["rss_mb"], u["footprint_mb"]
        idle = cpu_over(inst, IDLE_S)
        out["cpu_idle_pct"], out["wakeups_idle_per_s"] = idle["cpu_pct"], idle["wakeups_per_s"]
        out["frames_idle"], out["dial_frames_idle"] = idle["frames"], idle["dial_frames"]
        out["ticks_idle"] = idle["ticks"]
        panes = []
        for _ in range(TERMS):
            before = {p["id"] for p in inst.state()["state"]["panes"]}
            inst.ok({"cmd": "split", "axis": "right" if len(panes) % 2 else "down"})
            panes += [p["id"] for p in inst.state()["state"]["panes"] if p["id"] not in before]
        if len(panes) != TERMS:  # a start has no pane: each split opens one terminal
            raise Failed(f"{len(panes)} terminals opened, not {TERMS}")
        for pane in panes:
            inst.ok({"cmd": "type", "pane": pane, "text": f"seq 1 {SCROLLBACK} && echo bench-done\r"})
        for pane in panes:
            inst.ok({"cmd": "wait", "pane": pane, "pattern": "^bench-done$", "timeout_ms": 60000})
        inst.settle()
        time.sleep(3)
        u = usage(inst.proc.pid)
        out["rss_8_terms_mb"], out["footprint_8_terms_mb"] = u["rss_mb"], u["footprint_mb"]
        # About 2500 lines a second: 50, then 20 ms of sleep. A fixed load, so the CPU it takes compares.
        loop = ('i=0; while :; do j=0; while [ $j -lt 50 ]; do i=$((i+1)); j=$((j+1)); '
                'echo "made-up build output line $i: compiling crate $j of 50"; done; sleep 0.02; done\r')
        inst.ok({"cmd": "type", "pane": panes[0], "text": loop})
        time.sleep(1)
        out["cpu_stream_pct"] = cpu_over(inst, STREAM_S)["cpu_pct"]
        # The same, its pane in a tab not on show: nothing on screen changes, so no frame need draw.
        inst.ok({"cmd": "new_tab"})
        time.sleep(1)
        hidden = cpu_over(inst, STREAM_S)
        out["cpu_hidden_stream_pct"], out["frames_hidden_stream"] = hidden["cpu_pct"], hidden["frames"]
        inst.ok({"cmd": "type", "pane": panes[0], "text": "\x03"})
        return out
    finally:
        inst.close()


def city(binary, scratch, files):
    """Milliseconds from a repository's tab emptied to its code city painted (`city.picture`),
    a made-up tree of `files` files."""
    # Resolved: the repository listed and the one opened are the same string (`/tmp` is a link).
    tree = os.path.realpath(os.path.join(scratch, f"city-{files}"))
    if not os.path.isdir(tree):
        shot.made_up_tree(tree, files)
    inst = launch(binary, {"OTTOSPACE_FEATURES": "code_city", "GIT_CONFIG_GLOBAL": "/dev/null"})
    try:
        inst.ok({"cmd": "repo_add", "path": tree})
        inst.wait("the repository listed", lambda: shot.path_get(inst.state(), "repos_bar.0") is not None)
        inst.ok({"cmd": "open_repo", "path": tree})
        start = time.perf_counter()
        inst.ok({"cmd": "close"})
        inst.wait("the city", lambda: shot.path_get(inst.state(), "city.picture") is not None, timeout=60)
        return (time.perf_counter() - start) * 1000
    finally:
        inst.close()


def trace_events(inst):
    """The app's trace ring, oldest first: `{"ms", "ev", ..}` each."""
    said = inst.call({"cmd": "trace"})
    return [json.loads(line) for line in (said.get("trace") or "").splitlines() if line.strip()]


def pct(values, p):
    """The nearest-rank percentile `p` of `values` (none: None)."""
    values = sorted(values)
    return values[min(len(values) - 1, max(0, -(-len(values) * p // 100) - 1))] if values else None


def motion_of(events, start, end):
    """Frame and picture times of the trace's events from `start` to `end` (its ms)."""
    inside = [e for e in events if start <= e.get("ms", -1) <= end]
    frames = [e for e in inside if e.get("ev") == "frame"]
    took = [e["took_ms"] for e in frames]
    at = [e["ms"] for e in frames]
    gaps = [b - a for a, b in zip(at, at[1:])]
    pictures = [e for e in inside if e.get("ev") == "city_picture"]
    med = lambda key: statistics.median([e[key] / 1000 for e in pictures]) if pictures else None
    p95 = lambda key: pct([e[key] / 1000 for e in pictures], 95) if pictures else None
    return {
        "frames": len(frames), "frame_median": statistics.median(took) if took else None,
        "frame_p95": pct(took, 95), "over_16": sum(1 for t in took if t > 16.7),
        "gap_median": statistics.median(gaps) if gaps else None, "gap_p95": pct(gaps, 95),
        "gaps_over_16": sum(1 for g in gaps if g > 16.7), "pictures": len(pictures),
        "scene_ms": med("scene_us"), "gpu_ms": med("gpu_us"), "gpu_p95": p95("gpu_us"),
        "copy_ms": med("copy_us"), "copy_p95": p95("copy_us"), "image_ms": med("image_us"),
        "marks_ms": stat([e["us"] / 1000 for e in inside if e.get("ev") == "city_marks"], 50),
        "paint_ms": stat([e["us"] / 1000 for e in inside if e.get("ev") == "city_paint"], 50),
        "paint_p95": stat([e["us"] / 1000 for e in inside if e.get("ev") == "city_paint"], 95),
    }


def stat(values, p):
    """The median (`p` 50) or another percentile of `values`; none: None."""
    return (statistics.median(values) if p == 50 else pct(values, p)) if values else None


MOTION_RUNS = 3


def median_of(runs):
    """Each measure's median over `runs` (dicts of numbers or None)."""
    keys = runs[0].keys()
    out = {}
    for key in keys:
        values = [r[key] for r in runs if r[key] is not None]
        out[key] = statistics.median(values) if values else None
    return out


def city_motion(binary, scratch, files):
    """The code city's frames as it rises and as the user's drag turns it (`motion_of`), a
    made-up tree of `files` files, at CI's window."""
    tree = os.path.realpath(os.path.join(scratch, f"city-{files}"))
    if not os.path.isdir(tree):
        shot.made_up_tree(tree, files)
    env = {"OTTOSPACE_FEATURES": "code_city", "GIT_CONFIG_GLOBAL": "/dev/null", "OTTOSPACE_E2E_WINDOW": "1024x674"}
    inst = launch(binary, env)
    last = lambda: max([e.get("ms", 0) for e in trace_events(inst)] or [0])
    try:
        inst.ok({"cmd": "repo_add", "path": tree})
        inst.wait("the repository listed", lambda: shot.path_get(inst.state(), "repos_bar.0") is not None)
        inst.ok({"cmd": "open_repo", "path": tree})
        inst.ok({"cmd": "key", "keys": "cmd-shift-r", "as": "user"})
        start = last()
        inst.ok({"cmd": "close"})
        inst.wait("the city standing", lambda: shot.path_get(inst.state(), "city.first_ms") is not None, timeout=60)
        time.sleep(1)
        rise = motion_of(trace_events(inst), start, last())
        b = shot.path_get(inst.state(), "city.bounds")
        x, y = b[0] + b[2] * 0.35, b[1] + b[3] * 0.8
        mouse = lambda action, x: inst.ok({"cmd": "mouse", "action": action, "x": x, "y": y, "button": "left", "as": "user"})
        start = last()
        mouse("down", x)
        for i in range(1, 121):
            mouse("move", x + 3 * i)
        mouse("up", x + 360)
        time.sleep(0.5)
        turn = motion_of(trace_events(inst), start, last())
        # At rest after it: the picture full size and named again, then no frame and no picture.
        city = shot.path_get(inst.state(), "city")
        full = [round(v * city["scale"]) for v in city["bounds"][2:]]
        turn["rest_full"] = int(city["picture"] == full and city["labels"] > 0)
        start = last()
        time.sleep(2)
        after = [e for e in trace_events(inst) if e.get("ms", 0) > start]
        turn["rest_frames"] = sum(1 for e in after if e.get("ev") == "frame")
        turn["rest_pictures"] = sum(1 for e in after if e.get("ev") == "city_picture")
        for key in ("rest_full", "rest_frames", "rest_pictures"):
            rise[key] = None
        return {"rise": rise, "turn": turn}
    finally:
        inst.close()


SPINS = [(9500, 900, 8)]
# Config-repository shaped, folders in proportion: empty files (a stat is a stat; 600,000 of
# 7 KB would not fit a runner's disk).
LARGE = [(50000, 6800, 9), (60000, 8160, 9), (200000, 27200, 9), (600000, 81600, 9)]


def city_spin(binary, scratch, files, folders, deepest, live=False):
    """The Developer command's spin of a made-up repository (`shot.made_up_repo`) at CI's window:
    the app's own numbers (`city.spin.result`) and, from the trace, each stage's median and p95.
    None: a build with no spin, or no city (too many files)."""
    tree = os.path.realpath(os.path.join(scratch, f"repo-{files}"))
    if not os.path.isdir(tree):
        shot.made_up_repo(tree, files, folders, deepest, empty=files > 10000)
    # `live`: drawn on its live layer (`city_live_layer`); a build with no such flag draws none.
    features = "code_city,city_live_layer" if live else "code_city"
    env = {"OTTOSPACE_FEATURES": features, "GIT_CONFIG_GLOBAL": "/dev/null", "OTTOSPACE_E2E_WINDOW": "1024x674"}
    try:
        inst = launch(binary, env)
    except Failed:
        # A build that knows no such flag refuses to start: no live path to spin.
        if live:
            return None
        raise
    last = lambda: max([e.get("ms", 0) for e in trace_events(inst)] or [0])
    try:
        inst.ok({"cmd": "repo_add", "path": tree})
        inst.wait("the repository listed", lambda: shot.path_get(inst.state(), "repos_bar.0") is not None)
        inst.ok({"cmd": "open_repo", "path": tree})
        inst.ok({"cmd": "close"})
        # 600,000 files take about 30 s to read. A read that came with no city (past a build's
        # limit) ends the wait at once.
        read = lambda s: shot.path_get(s, "city.picture") is not None or (shot.path_get(s, "counts.city_reads") or 0) > 0
        inst.wait("the city", lambda: read(inst.state()), timeout=240)
        if shot.path_get(inst.state(), "city.picture") is None:
            time.sleep(2)
        if shot.path_get(inst.state(), "city.picture") is None:
            return None
        time.sleep(1)
        start = last()
        if inst.call({"cmd": "city_spin"}).get("ok") is not True:
            return None
        # Asked seldom: a state's reply is the main thread's work too.
        inst.poll = 0.5
        inst.wait("the spin", lambda: shot.path_get(inst.state(), "city.spin.result") is not None, timeout=300)
        inst.poll = 0.02
        spun = shot.path_get(inst.state(), "city.spin.result")
        events = [e for e in trace_events(inst) if e.get("ms", -1) >= start]
        pictures = [e for e in events if e.get("ev") == "city_picture"]
        paints = [e for e in events if e.get("ev") == "city_paint" and e.get("new")]
        took = lambda key, es=pictures: [e[key] / 1000 for e in es if key in e]
        for key in ("boxes_us", "alloc_us", "gpu_us", "copy_us", "image_us"):
            spun[key[:-3] + "_ms"], spun[key[:-3] + "_p95"] = stat(took(key), 50), stat(took(key), 95)
        spun["upload_ms"], spun["upload_p95"] = stat(took("us", paints), 50), stat(took("us", paints), 95)
        frames = [e["took_ms"] for e in events if e.get("ev") == "frame"]
        spun["cpu_frame_ms"], spun["cpu_frame_p95"] = stat(frames, 50), stat(frames, 95)
        spun["pictures"] = len(pictures)
        return spun
    finally:
        inst.close()


TYPING = (("idle", False, False), ("busy", False, True), ("full", True, False))


def typing(binary, full, busy):
    """The Developer command's timed typing at CI's window: the app's numbers (`typing.result`).
    None: a build with no timed typing."""
    inst = launch(binary, {"OTTOSPACE_E2E_WINDOW": "1024x674"})
    try:
        inst.ok({"cmd": "split"})
        time.sleep(1)
        if inst.call({"cmd": "typing_time", "full": full, "busy": busy}).get("ok") is not True:
            return None
        # Not asked meanwhile: a state's reply is the main thread's work too.
        time.sleep(17)
        inst.poll = 0.5
        inst.wait("the run", lambda: shot.path_get(inst.state(), "typing.result") is not None, timeout=60)
        typed = shot.path_get(inst.state(), "typing.result")
        # A run cut short, or one whose echoes were mostly never painted, measures nothing.
        return typed if typed["done"] and typed["total"]["n"] >= 200 else None
    finally:
        inst.close()


def stats(values):
    values = sorted(values)
    p90 = values[min(len(values) - 1, max(0, -(-len(values) * 9 // 10) - 1))]  # nearest rank
    return {"median": statistics.median(values), "p90": p90, "runs": [round(v, 1) for v in values]}


def order_of(names, i):
    """Each side in turn, alternating which goes first."""
    return names if i % 2 == 0 else names[::-1]


def startups(sides, args, scratch, raw, templates):
    """One round of every startup measure into `raw`. Each runs every side in turn, alternating
    which goes first."""
    names = list(sides)
    order = lambda i: names if i % 2 == 0 else names[::-1]

    say("startup, warm ...")
    for name in names:
        startup(sides[name])  # unmeasured: the binary's first launch (in a round)
    for i in range(args.runs):
        for name in order(i):
            raw[name]["warm"].append(startup(sides[name])["ms"])

    say("startup, cold ...")
    for i in range(args.cold_runs):
        for name in order(i):
            fresh = os.path.join(scratch, f"cold-{name}-{i}")
            os.makedirs(fresh)
            copy = os.path.join(fresh, "ottospace")
            subprocess.run(["cp", "-c", sides[name], copy], check=True)
            raw[name]["cold"].append(startup(copy)["ms"])
            shutil.rmtree(fresh)

    say("startup, with sessions ...")
    for i in range(args.runs):
        for name in order(i):
            home = os.path.join(scratch, f"home-{name}-{i}")
            shutil.copytree(templates[name], home)
            row = startup(sides[name], {"OTTOSPACE_HOME": home}, sessions=True)
            raw[name]["sessions"].append(row["ms"])
            raw[name]["sessions_read"].append(row["sessions_ms"])
            shutil.rmtree(home)


def startup_stats(r):
    return {
        "startup_warm_ms": stats(r["warm"]),
        "startup_cold_ms": stats(r["cold"]),
        "startup_sessions_ms": stats(r["sessions"]),
        "sessions_read_ms": stats(r["sessions_read"]),
    }


def bench(sides, args, scratch):
    """`sides`: {name: binary}. Returns each side's numbers."""
    names = list(sides)
    fresh = lambda: {name: {"warm": [], "cold": [], "sessions": [], "sessions_read": []} for name in names}
    raw = fresh()
    # A fixture a side, its layout saved by that side's own build.
    templates = {}
    for name in names:
        templates[name] = make_fixture(os.path.join(scratch, f"fixture-{name}"))
        prime(sides[name], templates[name])
    startups(sides, args, scratch, raw, templates)
    # A hosted runner's launches vary 3x: a startup past a threshold runs a second round, and
    # fails only if it is past it in each round (`held`); the table pools both rounds.
    held = set(past(*(startup_stats(raw[n]) for n in names))) if len(names) == 2 else set()
    if held:
        say("a startup is past a threshold: a second round, to confirm ...")
        again = fresh()
        startups(sides, args, scratch, again, templates)
        held &= set(past(*(startup_stats(again[n]) for n in names)))
        for name in names:
            for key, runs in again[name].items():
                raw[name][key] += runs
    say("code city ...")
    cities = {name: {2000: [], 20000: []} for name in names}
    for i in range(max(1, args.runs // 2)):
        for name in order_of(names, i):
            for files in cities[name]:
                cities[name][files].append(city(sides[name], scratch, files))
    say(f"code city in motion ({MOTION_RUNS} runs a side) ...")
    runs = {name: {files: [] for files in (2000, 20000)} for name in names}
    for i in range(MOTION_RUNS):
        for name in order_of(names, i):
            for files in runs[name]:
                runs[name][files].append(city_motion(sides[name], scratch, files))
    motion = {
        name: {files: {phase: median_of([r[phase] for r in rs]) for phase in ("rise", "turn")} for files, rs in by.items()}
        for name, by in runs.items()
    }
    say(f"code city spun ({MOTION_RUNS} runs a side) ...")
    sizes = SPINS + (LARGE if args.city_large else [])
    # Each side spun on both paths: the picture painted by GPUI (off) and its live layer (on).
    spins = {name: {(size[0], live): [] for size in sizes for live in (False, True)} for name in names}
    for i in range(MOTION_RUNS):
        for name in order_of(names, i):
            for size in sizes:
                for live in (False, True):
                    # A size or path a side drew no city for once (past its limit, no flag) is not tried again.
                    done = spins[name][(size[0], live)]
                    if i and done and done[-1] is None:
                        continue
                    done.append(city_spin(sides[name], scratch, *size, live=live))
    say("typing ...")
    typed = {name: {kind: typing(sides[name], full, busy) for kind, full, busy in TYPING} for name in names}
    result = {}
    for name in names:
        say(f"memory and CPU, {name} ({IDLE_S + STREAM_S + 20} s) ...")
        result[name] = {**startup_stats(raw[name]), **{k: v if v is None else round(v, 2) for k, v in long_run(sides[name]).items()}}
        result[name].update({f"city_{files}_ms": stats(runs) for files, runs in cities[name].items()})
        result[name]["motion"] = motion[name]
        spun = {key: [r for r in rs if r] for key, rs in spins[name].items()}
        result[name]["spin"] = {files: median_of(rs) if rs else None for (files, live), rs in spun.items() if not live}
        result[name]["spin_live"] = {files: median_of(rs) if rs else None for (files, live), rs in spun.items() if live}
        if spun.get((9500, False)):
            result[name]["spin_9500_p99_ms"] = result[name]["spin"][9500]["p99"]
            result[name]["spin_9500_over_33"] = result[name]["spin"][9500]["over_33"]
            result[name]["spin_9500_repeats"] = result[name]["spin"][9500]["repeats"]
            result[name]["spin_9500_wait_p50_ms"] = result[name]["spin"][9500]["wait_p50"]
        result[name]["typing"] = typed[name]
        for kind, t in typed[name].items():
            if t:
                pre = "typing" if kind == "idle" else f"typing_{kind}"
                result[name][f"{pre}_total_p99_ms"] = t["total"]["p99"]
                result[name][f"{pre}_app_p99_ms"] = t["app"]["p99"]
        if spun.get((9500, True)):
            result[name]["spin_live_9500_repeats"] = result[name]["spin_live"][9500]["repeats"]
        result[name]["release"] = args.release
    return result, sorted(held)


# ---------------------------------------------------------------------------------- report

ROWS = [
    ("startup_warm_ms", "startup, warm (ms)"),
    ("startup_cold_ms", "startup, cold (ms)"),
    ("startup_sessions_ms", "startup, 50 sessions + tasks + layout (ms)"),
    ("sessions_read_ms", "  then the sessions listed (ms)"),
    ("rss_idle_mb", "RSS, idle (MB)"),
    ("footprint_idle_mb", "footprint, idle (MB)"),
    ("rss_8_terms_mb", f"RSS, {TERMS} terminals × {SCROLLBACK} lines (MB)"),
    ("footprint_8_terms_mb", f"footprint, {TERMS} terminals (MB)"),
    ("cpu_idle_pct", f"CPU, idle {IDLE_S} s (%)"),
    ("wakeups_idle_per_s", "  wakeups a second, idle"),
    ("frames_idle", f"  frames drawn, idle {IDLE_S} s"),
    ("dial_frames_idle", f"  dial frames, idle {IDLE_S} s"),
    ("ticks_idle", f"  tick runs, idle {IDLE_S} s"),
    ("cpu_stream_pct", f"CPU, a terminal streaming {STREAM_S} s (%)"),
    ("cpu_hidden_stream_pct", "  its tab not on show: CPU (%)"),
    ("frames_hidden_stream", f"    frames drawn in those {STREAM_S} s"),
    ("city_2000_ms", "code city, 2,000 files: tab emptied to picture (ms)"),
    ("city_20000_ms", "code city, 20,000 files (ms)"),
    ("spin_9500_p99_ms", "code city spun, 9,500 files: frames' p99 (ms)"),
    ("spin_9500_over_33", "  frames over 33 ms"),
    ("spin_9500_repeats", "  frames that repeated the picture before"),
    ("spin_9500_wait_p50_ms", "  a new picture's wait, made to painted, p50 (ms)"),
    ("typing_total_p99_ms", "typing at a prompt: key to painted echo, p99 (ms)"),
    ("typing_app_p99_ms", "  the app's own share, p99 (ms)"),
    ("typing_busy_total_p99_ms", "  beside a busy pane: key to painted, p99 (ms)"),
    ("typing_busy_app_p99_ms", "    the app's own share, p99 (ms)"),
    ("typing_full_total_p99_ms", "  a full-screen program: key to painted, p99 (ms)"),
    ("typing_full_app_p99_ms", "    the app's own share, p99 (ms)"),
]


def value(side, key):
    v = side.get(key)
    return v["median"] if isinstance(v, dict) else v


def cell(side, key):
    v = side.get(key)
    if v is None:
        return "—"
    if isinstance(v, dict):
        return f"{v['median']:.0f} / {v['p90']:.0f}"
    return f"{v:.1f}" if isinstance(v, float) else str(v)


def past(before, after):
    """The metrics of `after` past their threshold over `before` (those both have)."""
    found = []
    for key, rel, rise, floor in THRESHOLDS:
        if key not in before or key not in after:
            continue
        b, a = value(before, key), value(after, key)
        if a > floor and a - b > rise and (rel is None or b <= 0 or (a - b) / b > rel):
            found.append(key)
    return found


def regressions(before, after, held):
    """What fails: a startup past its threshold in every round (`held`), any other metric past its own."""
    keys = [k for k, *_ in THRESHOLDS if k in held or (not k.startswith("startup_") and k in past(before, after))]
    found = [f"{k}: {value(before, k):.1f} → {value(after, k):.1f}" for k in keys]
    found += [f"{k}: {after[k]:.1f} ms, past {limit} ms" for k, limit in CEILINGS if (after.get(k) or 0) > limit]
    # The live layer in a release build: a new picture each display refresh, a turn's frames
    # repeating none but a few (a debug build's picture thread is too slow to hold it).
    live = after.get("spin_live_9500_repeats")
    if after.get("release") and live is not None and live > LIVE_REPEATS:
        found.append(f"spin_live_9500_repeats: {live:.0f} (at most {LIVE_REPEATS} in a release build)")
    # A spin the base made and this side did not (no city, a failed spin): never a pass by absence.
    if "spin_9500_p99_ms" in before and "spin_9500_p99_ms" not in after:
        found.append("spin_9500: the base spun, this side did not")
    for kind in ("typing", "typing_busy", "typing_full"):
        if f"{kind}_total_p99_ms" in before and f"{kind}_total_p99_ms" not in after:
            found.append(f"{kind}: the base timed it, this side did not (or its run failed)")
    return found


def motion_table(result):
    """The code city in motion, each side: a row a phase and size."""
    f = lambda v, d=1: "—" if v is None else f"{v:.{d}f}"
    lines = ["", f"Code city in motion, at 1024×674, the median of {MOTION_RUNS} runs a side (frame: render to paint on the main thread; gap: from one frame to the next; picture: made on its own thread; paint: the picture's paint on the main thread):", "",
             "| side | phase | files | frames | frame median / p95 (ms) | over 16.7 | gap median / p95 (ms) | gaps over 16.7 | pictures | scene / GPU (p95) / copy out (p95) / image / names (ms) | paint median / p95 (ms) | after it: full size and named (runs) / frames / pictures in 2 s |",
             "|---|---|---|---|---|---|---|---|---|---|---|---|"]
    for name, side in result.items():
        for files, phases in (side.get("motion") or {}).items():
            for phase in ("rise", "turn"):
                m = phases[phase]
                lines.append(
                    f"| {name} | {phase} | {files:,} | {m['frames']} | {f(m['frame_median'])} / {f(m['frame_p95'])} | {m['over_16']} | "
                    f"{f(m['gap_median'])} / {f(m['gap_p95'])} | {m['gaps_over_16']} | {m['pictures']} | "
                    f"{f(m['scene_ms'])} / {f(m['gpu_ms'])} ({f(m['gpu_p95'])}) / {f(m['copy_ms'])} ({f(m['copy_p95'])}) / {f(m['image_ms'])} / {f(m.get('marks_ms'))} | "
                    f"{f(m.get('paint_ms'))} / {f(m.get('paint_p95'))} | {f(m.get('rest_full'), 0)} / {f(m.get('rest_frames'), 0)} / {f(m.get('rest_pictures'), 0)} |")
    return lines


def spin_table(result):
    """The spins, each side and size: the app's frames, then each stage per picture."""
    f = lambda v, d=1: "—" if v is None else f"{v:.{d}f}"
    lines = ["", f"Code city spun once round (240 steps, a step a frame), at 1024×674, the median of {MOTION_RUNS} runs a side "
             "on both paths: the picture painted by GPUI as an image, and the city's live layer (`city_live_layer`) "
             "(frame: from one frame to the next; repeated: frames with no new picture since the frame before (a new image "
             "painted, or a present on the layer); wait: a new picture from made to painted (the image path's); shown: a step's "
             "picture from its place asking to it shown (painted, or presented); render: each picture on its thread; CPU frame: render to paint on the main thread; upload: a new picture into GPUI's atlas):", "",
             "| side, path | files | frames | mean | p50 | p95 | p99 | max | over 16.7 | over 33 | repeated | wait p50 / p95 / max | shown p50 / p95 / p99 | render p50 / p95 | CPU frame p50 / p95 | pictures | boxes / textures / GPU (p95) / copy out (p95) / image (ms) | upload p50 / p95 |",
             "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
    rows = [(f"{name}, {path}", files, m) for name, side in result.items()
            for path, key in (("image", "spin"), ("live layer", "spin_live")) for files, m in (side.get(key) or {}).items()]
    for name, files, m in rows:
            if m is None:
                lines.append(f"| {name} | {files:,} | no city or no spin |" + " |" * 15)
                continue
            lines.append(
                f"| {name} | {files:,} | {f(m['frames'], 0)} | {f(m['mean'])} | {f(m['p50'])} | {f(m['p95'])} | {f(m['p99'])} | {f(m['max'])} | "
                f"{f(m['over_16'], 0)} | {f(m['over_33'], 0)} | {f(m['repeats'], 0)} | {f(m['wait_p50'])} / {f(m['wait_p95'])} / {f(m['wait_max'])} | "
                f"{f(m.get('shown_p50'))} / {f(m.get('shown_p95'))} / {f(m.get('shown_p99'))} | "
                f"{f(m.get('render_p50'))} / {f(m.get('render_p95'))} | "
                f"{f(m.get('cpu_frame_ms'))} / {f(m.get('cpu_frame_p95'))} | {f(m.get('pictures'), 0)} | "
                f"{f(m.get('boxes_ms'))} / {f(m.get('alloc_ms'))} / {f(m.get('gpu_ms'))} ({f(m.get('gpu_p95'))}) / {f(m.get('copy_ms'))} ({f(m.get('copy_p95'))}) / {f(m.get('image_ms'))} | "
                f"{f(m.get('upload_ms'))} / {f(m.get('upload_p95'))} |")
    return lines


def typing_table(result):
    """Timed typing, each side and run: each stage's p50 / p95 / p99 / max (ms)."""
    f = lambda d: "—" if not d else f"{d['p50']:.1f} / {d['p95']:.1f} / {d['p99']:.1f} / {d['max']:.1f}"
    lines = ["", "Timed typing, 250 made-up keys, at 1024×674 (p50 / p95 / p99 / max, ms; app: key to write plus parsed to taken):", "",
             "| side | run | display Hz | missed | key → write | write → echo parsed | parsed → taken | taken → painted | app's share | key → painted |",
             "|---|---|---|---|---|---|---|---|---|---|"]
    for name, side in result.items():
        for kind, t in (side.get("typing") or {}).items():
            if not t:
                lines.append(f"| {name} | {kind} | no timed typing |" + " |" * 7)
                continue
            lines.append(f"| {name} | {kind} | {t['hz']:.0f} | {t['missed']} | {f(t['key_write'])} | {f(t['write_echo'])} | "
                         f"{f(t['echo_taken'])} | {f(t['taken_painted'])} | {f(t['app'])} | {f(t['total'])} |")
    return lines


def table(result, meta):
    names = list(result)
    first = result[names[0]]
    runs, cold = len(first["startup_warm_ms"]["runs"]), len(first["startup_cold_ms"]["runs"])
    lines = [f"Build: {meta['profile']}. Startups: median / p90 of {runs} runs (cold: {cold}).", ""]
    if len(names) == 1:
        lines += ["| | value |", "|---|---|"]
        lines += [f"| {label} | {cell(result[names[0]], key)} |" for key, label in ROWS]
        return "\n".join(lines + motion_table(result) + spin_table(result) + typing_table(result)) + "\n"
    b, a = result[names[0]], result[names[1]]
    lines += [f"| | {names[0]} | {names[1]} | Δ |", "|---|---|---|---|"]
    for key, label in ROWS:
        vb, va = value(b, key), value(a, key)
        if vb is None or va is None:
            delta = ""
        else:
            delta = f"{(va - vb) / vb * 100:+.0f}%" if vb else f"{va - vb:+.1f}"
        lines.append(f"| {label} | {cell(b, key)} | {cell(a, key)} | {delta} |")
    found = regressions(b, a, meta["startup_held"])
    lines += ["", "**Past a threshold:** " + "; ".join(found) if found else "No metric past a threshold."]
    lines += ["", "Thresholds: " + LIMITS]
    lines += motion_table(result) + spin_table(result) + typing_table(result)
    return "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--bin", help="the ottospace binary (default: cargo build this tree)")
    parser.add_argument("--compare", metavar="BASE", help="BASE (before) against HEAD as committed (after), both built alike")
    parser.add_argument("--bin-before")
    parser.add_argument("--bin-after")
    parser.add_argument("--release", action="store_true", help="release builds (default: dev, as CI's cache)")
    parser.add_argument("--runs", type=int, default=10)
    parser.add_argument("--cold-runs", type=int, default=5)
    parser.add_argument("--out", default=os.path.join(REPO, ".bench"))
    parser.add_argument("--city-large", action="store_true", help="also spin 50,000, 60,000, 200,000 and 600,000 files (slow)")
    args = parser.parse_args()
    if args.runs < 1 or args.cold_runs < 1:
        parser.error("--runs and --cold-runs: at least 1")
    if shot.screen_locked():
        say("the screen is locked: nothing draws. Unlock it and run again")
        return 3
    cargo = ["--release"] if args.release else []
    scratch = tempfile.mkdtemp(prefix="ottospace-bench-")
    try:
        if args.compare:
            # Both sides built alike, each in a worktree of its own: an A/A run of one commit against
            # itself put its after side's city 28% slower when the after binary was built apart.
            before = args.bin_before or shot.build_ref(args.compare, scratch, cargo)
            after = args.bin_after or shot.build_ref("HEAD", scratch, cargo, side="after")
            sides = {"before": before, "after": after}
        else:
            sides = {"this": args.bin or shot.build(REPO, os.path.join(scratch, "ottospace"), None, cargo)}
        result, held = bench(sides, args, scratch)
        commit = subprocess.run(["git", "-C", REPO, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
        meta = {"profile": "release" if args.release else "dev", "runs": args.runs, "cold_runs": args.cold_runs,
                "commit": commit, "base": args.compare, "machine": os.uname().machine,
                "date": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "startup_held": held}
        md = table(result, meta)
        os.makedirs(args.out, exist_ok=True)
        with open(os.path.join(args.out, "bench.json"), "w") as f:
            json.dump({"meta": meta, "result": result}, f, indent=2)
        with open(os.path.join(args.out, "bench.md"), "w") as f:
            f.write(md)
    except Failed as err:
        say(f"bench: {err}")
        return 2
    # Any other error (a missing binary, a socket timeout, an --out that is a file) is the bench's
    # too: 2, never 1.
    except Exception:
        traceback.print_exc()
        return 2
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    print(md)
    say(f"wrote {args.out}/bench.json and bench.md")
    return 1 if len(result) == 2 and regressions(result["before"], result["after"], held) else 0

if __name__ == "__main__":
    sys.exit(main())

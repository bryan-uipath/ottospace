# Native chat: a long draft wraps in the composer; a message queued while a turn runs; Stop while a turn runs, the agent stopped, then Resume. The stand-in `claude`
# writes its session file so the stop can be gone on with; its resume prints hook lines.
{"env":{"OTTOSPACE_AGENTS_DIR":"{ROOT}/bin"}}
{"cmd":"split","kind":"empty"}
{"cmd":"task_new","line":"plan the week >app"}
{"cmd":"section","section":"tasks"}
{"click":"task:1","at":[0.3,0.3]}
{"click":"talk:talk-start"}
{"until":"drawer.native.chats.1.replies","len":1}
{"click":"talk"}
{"cmd":"key","keys":"m a d e space u p space w o r d s space m a d e space u p space w o r d s space m a d e space u p space w o r d s space m a d e space u p space w o r d s space m a d e space u p space w o r d s space m a d e space u p space w o r d s alt-enter s e c o n d space l i n e","as":"user"}
{"settle":300}
{"shot":"composer"}
{"cmd":"key","keys":"ctrl-u","as":"user"}
{"cmd":"key","keys":"g o space o n enter","as":"user"}
{"until":"drawer.native.chats.1.transcript.turn"}
{"settle":800}
{"shot":"turn"}
{"settle":700}
{"shot":"turn-sweep"}
{"cmd":"key","keys":"a l s o space c h e c k space t h e space d o c s enter","as":"user"}
{"settle":300}
{"shot":"queued"}
{"cmd":"key","keys":"cmd-shift-p","as":"user"}
{"cmd":"key","keys":"s t o p space t h e space a g e n t","as":"user"}
{"cmd":"key","keys":"enter","as":"user"}
{"until":"drawer.native.chats.1.transcript.live","is":false}
{"shot":"stopped"}
{"click":"talk:talk-start"}
{"until":"drawer.native.chats.1.transcript.live","is":true}
{"settle":800}
{"shot":"resumed"}

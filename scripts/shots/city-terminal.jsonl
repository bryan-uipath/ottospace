# A `claude` in the user's own terminal (a made-up session, no task's) reading a made-up file of the
# checkout floats on the city of a task's space there (`code_city`), beside the task's own agent,
# at no file (`terminal`). Waits by time: a base without the session takes the same picture.
{"env": {"OTTOSPACE_FEATURES": "code_city"}}
{"tree": "repos/app", "files": 60}
{"cmd": "repo_add", "path": "{ROOT}/repos/app"}
{"until": "repos_bar.0"}
{"cmd": "task_new", "line": "fix the login loop >app"}
{"cmd": "section", "section": "tasks"}
{"click": "task:1", "at": [0.3, 0.3]}
{"click": "talk:talk-start"}
{"cmd": "key", "keys": "cmd-shift-r", "as": "user"}
{"cmd": "open_space", "space": {"kind": "task", "id": 1}}
{"until": "city.picture", "timeout_ms": 30000}
{"sleep_ms": 5000}
{"settle": 1000}
{"shot": "terminal"}

# The code city's folders as plinths, buildings of glass: code-city's small repository (`app`, 31
# files; city-plinths/ is a link to code-city/, listed by its settings) and a made-up tree of
# 2,000 (`big`), as a repository's tab after its terminal closed; each also opaque
# (`developer.city_opaque`), for comparing. The settings written keep the launch's repositories
# (no restart toast); ⌘⇧R folds the new-task drawer so the city fills the tab. `print` gives each
# render time.
{"env": {"OTTOSPACE_FEATURES": "code_city"}}
{"tree": "repos/big", "files": 2000}
{"cmd": "repo_add", "path": "{ROOT}/repos/big"}
{"until": "repos_bar.1"}
{"cmd": "section", "section": "repos"}
{"cmd": "open_repo", "path": "{ROOT}/repos/app"}
{"cmd": "close"}
{"cmd": "key", "keys": "escape", "as": "user"}
{"cmd": "key", "keys": "cmd-shift-r", "as": "user"}
{"settle": 800}
{"until": "city.glass", "is": true, "timeout_ms": 30000}
{"settle": 500}
{"print": "city.render_us"}
{"shot": "app"}
{"write": "home/settings.json", "text": "{\"repos\": [\"{ROOT}/repos/app\", \"{ROOT}/repos/big\"], \"conversation_view\": \"native\", \"session_dirs\": {\"claude\": [\"{ROOT}/sessions/claude\"]}, \"restore_layout\": false, \"developer\": {\"city_opaque\": true}}\n"}
{"until": "city.glass", "is": false, "timeout_ms": 30000}
{"settle": 500}
{"print": "city.render_us"}
{"shot": "app-opaque"}
{"write": "home/settings.json", "text": "{\"repos\": [\"{ROOT}/repos/app\", \"{ROOT}/repos/big\"], \"conversation_view\": \"native\", \"session_dirs\": {\"claude\": [\"{ROOT}/sessions/claude\"]}, \"restore_layout\": false, \"developer\": {\"city_opaque\": false}}\n"}
{"until": "city.glass", "is": true, "timeout_ms": 30000}
{"cmd": "open_repo", "path": "{ROOT}/repos/big"}
{"cmd": "close"}
{"cmd": "key", "keys": "escape", "as": "user"}
{"settle": 800}
{"until": "city.places", "is": 2096, "timeout_ms": 60000}
{"settle": 500}
{"print": "city.render_us"}
{"shot": "big"}
{"write": "home/settings.json", "text": "{\"repos\": [\"{ROOT}/repos/app\", \"{ROOT}/repos/big\"], \"conversation_view\": \"native\", \"session_dirs\": {\"claude\": [\"{ROOT}/sessions/claude\"]}, \"restore_layout\": false, \"developer\": {\"city_opaque\": true}}\n"}
{"until": "city.glass", "is": false, "timeout_ms": 30000}
{"settle": 500}
{"print": "city.render_us"}
{"shot": "big-opaque"}

# A linked worktree's right click: its menu at the pointer (Delete worktree…), the question
# before it goes (⌘⌫ deletes, ↵ keeps), and a worktree a terminal is in: the item dimmed, with why.
{"cmd":"section","section":"repos"}
{"until":"repos_bar.1"}
{"cmd":"mouse","action":"move","x":-50,"y":-50,"as":"user"}
{"shot":"rows"}
{"click":"repo:{ROOT}/repos/canvas-app-2","button":"right","at":[0.35,0.5]}
{"until":"row_menu.worktree","is":"{ROOT}/repos/canvas-app-2"}
{"shot":"menu"}
{"click":"row-menu:0"}
{"until":"state.confirm.delete","is":"{ROOT}/repos/canvas-app-2"}
{"shot":"delete-ask"}
{"cmd":"key","keys":"enter","as":"user"}
{"until":"mode","is":"normal"}
{"cmd":"open_repo","path":"{ROOT}/repos/canvas-app-3"}
{"click":"repo:{ROOT}/repos/canvas-app-3","button":"right","at":[0.35,0.5]}
{"until":"row_menu.items.0.why","exists":true}
{"shot":"menu-busy"}

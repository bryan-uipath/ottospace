# Native chat: a reply, a tool row, an edit's diff card and a permission card (and the agent chip
# with the conversation closed on it); then an agent that ended before it replied, its chip the
# badge alone on a full tab row. The stand-in `claude` replays chat/fixtures.
{"env":{"OTTOSPACE_AGENTS_DIR":"{ROOT}/bin"}}
{"cmd":"split","kind":"empty"}
{"cmd":"task_new","line":"fix the login loop >app"}
{"cmd":"task_new","line":"plan the week >app"}
{"cmd":"section","section":"tasks"}
{"click":"task:1","at":[0.3,0.3]}
{"click":"talk:talk-start"}
{"until":"drawer.native.chats.1.transcript.cards","len":1}
{"shot":"permission"}
# The context dot before the first message, opened: what ottospace added to the run.
{"click":"chat-context:1"}
{"shot":"context-open"}
{"click":"chat-context:1"}
# The drawer at its narrowest: the foot keeps the folder whole. Then as wide as before.
{"drag":{"rect":"drawer.body"},"at":[0,0.5],"by":[200,0]}
{"shot":"narrow"}
{"drag":{"rect":"drawer.body"},"at":[0,0.5],"by":[-160,0]}
{"cmd":"key","keys":"cmd-shift-r","as":"user"}
{"settle":300}
{"shot":"closed-needs-you"}
{"cmd":"key","keys":"cmd-shift-r","as":"user"}
{"click":"task:2","at":[0.3,0.3]}
{"click":"talk:talk-start"}
{"until":"drawer.native.chats.2.transcript.live","is":false}
{"shot":"ended"}
{"cmd":"key","keys":"cmd-shift-r","as":"user"}
{"cmd":"key","keys":"cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t cmd-t","as":"user"}
{"settle":300}
{"shot":"closed-badge"}

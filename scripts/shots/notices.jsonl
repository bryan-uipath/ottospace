# Notices over a terminal pane: information, a warning and an error, each a toast card at the
# window's bottom right, over the status bar. The pane does not move for one.
{"cmd":"split"}
{"cmd":"wait","pattern":"^\\$"}
{"cmd":"type","text":"clear && for i in $(seq 1 60); do echo notices $i; done\r"}
{"cmd":"wait","pattern":"^notices 60$"}
{"record":"start"}
{"sleep_ms":500}
{"write":"home/settings.json","text":"{\"repos\": [], \"suggest_dock_apps\": false}\n"}
{"until":"notice_level","is":"info"}
{"sleep_ms":700}
{"shot":"info"}
{"write":"home/settings.json","text":"{\"repos\": [], \"calendar_window_hours\": 4}\n"}
{"until":"notice_level","is":"warning"}
{"sleep_ms":700}
{"shot":"warning"}
{"write":"home/settings.json","text":"{\"repos\": [], \"tasks_view\": \"project\",}\n"}
{"until":"notice_level","is":"error"}
{"sleep_ms":700}
{"shot":"error"}
{"write":"home/settings.json","text":"{\"repos\": []}\n"}
{"until":"notice","is":null}
{"sleep_ms":500}
{"record":"stop"}

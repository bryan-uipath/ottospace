# Transcripts: Transcribe in a pane's header, then the indicator there and on the top row, and the
# drawer's lines as they come. Pausing: transcript-paused. A test run hears no app: the fixture's made-up lines
# (transcript/fixture.jsonl) stand in for the sound, and a terminal pane for an app's.
{"env":{"OTTOSPACE_FEATURES":"transcripts","OTTOSPACE_LISTEN_FIXTURE":"{ROOT}/fixture.jsonl"}}
{"cmd":"split"}
{"cmd":"wait","pattern":"^\\$"}
{"cmd":"type","text":"clear && echo weekly sync\r"}
{"cmd":"wait","pattern":"^weekly sync$"}
{"shot":"offered"}
{"click":"listen-start:1"}
{"until":"listen_lines","len":6}
{"shot":"on"}

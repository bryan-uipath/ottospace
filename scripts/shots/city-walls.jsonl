# Top folders named on their plinths, deeper folders and files on labels over them
# (`city_wall_names`), in the picture.
# code-city's small repository (`app`; city-walls/ is a link to code-city/) and a made-up tree of
# 2,000 (`big`): at the fitted view, turned, zoomed in three times (the last close, then turned), and
# mid-drag (`app-turning`: the drag's half-size pictures keep their names).
{"env":{"OTTOSPACE_FEATURES":"code_city,city_wall_names"}}
{"tree":"repos/big","files":2000}
{"cmd":"repo_add","path":"{ROOT}/repos/big"}
{"until":"repos_bar.1"}
{"cmd":"section","section":"repos"}
{"cmd":"open_repo","path":"{ROOT}/repos/app"}
{"cmd":"close"}
{"cmd":"key","keys":"escape","as":"user"}
{"cmd":"key","keys":"cmd-shift-r","as":"user"}
{"until":"city.picture","timeout_ms":30000}
{"settle":800}
{"shot":"app-names"}
{"drag":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[120,-30]}
{"settle":800}
{"shot":"app-turned"}
{"hold":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[-200,10]}
{"settle":300}
{"shot":"app-turning"}
{"cmd":"key","keys":"escape","as":"user"}
{"click":"city:reset:tab"}
{"settle":500}
{"cmd":"open_repo","path":"{ROOT}/repos/big"}
{"cmd":"close"}
{"cmd":"key","keys":"escape","as":"user"}
{"until":"city.places","is":2096,"timeout_ms":60000}
{"settle":800}
{"shot":"big-names"}
{"wheel":{"rect":"city.bounds"},"at":[0.5,0.7],"dy":4}
{"settle":1500}
{"shot":"big-zoom-1"}
{"wheel":{"rect":"city.bounds"},"at":[0.5,0.7],"dy":6}
{"settle":1500}
{"shot":"big-zoom-2"}
{"wheel":{"rect":"city.bounds"},"at":[0.5,0.6],"dy":8}
{"settle":1500}
{"shot":"big-zoom-close"}
{"drag":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[160,-20]}
{"settle":1500}
{"shot":"big-close-turned"}
{"click":"city:reset:tab"}
{"settle":800}
{"drag":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[120,-30]}
{"settle":800}
{"shot":"big-turned"}
{"click":"city:reset:tab"}
{"settle":500}

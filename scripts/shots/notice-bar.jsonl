# The notice bar: information, a warning and an error, each opening between the top row and the rest.
{"cmd":"split"}
{"cmd":"wait","pattern":"^\\$"}
{"cmd":"type","text":"clear && echo notices\r"}
{"cmd":"wait","pattern":"^notices$"}
{"record":"start"}
{"sleep_ms":500}
{"write":"home/settings.json","text":"{\"repos\": [], \"suggest_dock_apps\": false}\n"}
{"until":"notice_bar.height","is":28.0}
{"sleep_ms":700}
{"shot":"info"}
{"write":"home/settings.json","text":"{\"repos\": [], \"calendar_window_hours\": 4}\n"}
{"until":"notice_level","is":"warning"}
{"sleep_ms":700}
{"shot":"warning"}
{"write":"home/settings.json","text":"{\"repos\": [], \"tasks_view\": \"project\",}\n"}
{"until":"notice_level","is":"error"}
{"sleep_ms":700}
{"shot":"error"}
{"write":"home/settings.json","text":"{\"repos\": []}\n"}
{"until":"notice_bar","is":null}
{"sleep_ms":500}
{"record":"stop"}

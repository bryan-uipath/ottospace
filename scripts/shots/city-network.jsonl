# A network call at the agent's icon (`code_city`): a made-up fetch runs and its antenna rises
# over the icon (`antenna`), in the Network station's colour; the base draws none.
{"env": {"OTTOSPACE_FEATURES": "code_city", "OTTOSPACE_REDUCE_MOTION": "1"}}
{"tree": "repos/app", "files": 60}
{"cmd": "repo_add", "path": "{ROOT}/repos/app"}
{"until": "repos_bar.0"}
{"cmd": "task_new", "line": "fix the login loop >app"}
{"cmd": "section", "section": "tasks"}
{"click": "task:1", "at": [0.3, 0.3]}
{"click": "talk:talk-start"}
{"cmd": "key", "keys": "cmd-shift-r", "as": "user"}
{"cmd": "open_space", "space": {"kind": "task", "id": 1}}
{"until": "city.picture", "timeout_ms": 30000}
{"until": "drawer.native.chats.1.dial.stations.4.running", "is": 1, "timeout_ms": 30000}
{"settle": 500}
{"shot": "antenna"}

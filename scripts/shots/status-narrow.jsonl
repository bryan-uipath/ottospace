# The status bar of a narrow window: the folder shortens first, then the meeting (`12 min`), then
# the agents (`● 2 ● 1`).
{"cmd":"split"}
{"cmd":"task_add","title":"Port the parser","state":"running"}
{"cmd":"task_add","title":"Fix the flaky upload test","state":"running"}
{"cmd":"task_add","title":"Approve the retry plan","state":"needs_you"}

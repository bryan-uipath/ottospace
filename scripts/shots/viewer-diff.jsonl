{"commit":"repos/notes"}
{"write": "repos/notes/src/store.rs", "text": "//! A made-up store of notes.\n\nuse std::collections::BTreeMap;\n\npub struct Store {\n    notes: BTreeMap<u32, String>,\n    next: u32,\n}\n\nimpl Store {\n    pub fn new() -> Self {\n        Store { notes: BTreeMap::new(), next: 1 }\n    }\n\n    /// Adds a note, trimmed; an empty one is none.\n    pub fn add(&mut self, text: &str) -> Option<u32> {\n        let text = text.trim();\n        if text.is_empty() {\n            return None;\n        }\n        let id = self.next;\n        self.notes.insert(id, text.to_string());\n        self.next += 1;\n        Some(id)\n    }\n\n    pub fn get(&self, id: u32) -> Option<&str> {\n        self.notes.get(&id).map(String::as_str)\n    }\n\n    pub fn len(&self) -> usize {\n        self.notes.len()\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.notes.is_empty()\n    }\n\n    pub fn clear(&mut self) {\n        self.notes.clear();\n    }\n\n    pub fn ids(&self) -> Vec<u32> {\n        self.notes.keys().copied().collect()\n    }\n\n    pub fn remove(&mut self, id: u32) -> Option<String> {\n        self.notes.remove(&id)\n    }\n}\n"}
{"cmd":"repo_add","path":"{ROOT}/repos/notes"}

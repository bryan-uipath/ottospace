# Decisions (`decisions` flag): two made-up tasks whose agents each wait on a question. ⌘J opens
# the card workspace, "Decisions · 1 of 2"; 1 answers and the next card shows while the seal plays;
# ⌘L talks the card over in the drawer, on the card's task. `--record` films the seal.
{"env":{"OTTOSPACE_FEATURES":"decisions"}}
{"cmd":"split","kind":"empty"}
{"cmd":"task_new","line":"Fix the login loop >app"}
{"cmd":"task_new","line":"Pick the cache for search >app"}
{"cmd":"section","section":"tasks"}
{"click":"task:1","at":[0.3,0.3]}
{"click":"talk:talk-start"}
{"click":"task:2","at":[0.3,0.3]}
{"click":"talk:talk-start"}
{"until":"drawer.native.chats.2.transcript.cards","len":1}
{"until":"drawer.native.chats.1.transcript.cards","len":1}
{"shot":"before"}
{"cmd":"key","keys":"cmd-j","as":"user"}
{"until":"state.decisions.at"}
{"settle":300}
{"shot":"card"}
{"record":"start"}
{"cmd":"key","keys":"1","as":"user"}
{"settle":120}
{"shot":"answered"}
{"sleep_ms":1200}
{"record":"stop"}
{"shot":"next"}
{"cmd":"key","keys":"cmd-l","as":"user"}
{"settle":300}
{"shot":"talk-over"}

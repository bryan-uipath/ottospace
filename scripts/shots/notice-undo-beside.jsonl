# A temporary workspace closed (Undo on the notice bar), then a settings mistake: the error takes
# the bar, and the workspace's Undo stays beside it, so it cannot run out unseen.
{"click":"top:new_workspace"}
{"click":"space-hide:1"}
{"until":"notice_bar.height","is":28.0}
{"shot":"undo"}
{"write":"home/settings.json","text":"{\"repos\": [], \"tasks_view\": \"project\",}\n"}
{"until":"notice_level","is":"error"}
{"settle":300}
{"shot":"error-and-undo"}

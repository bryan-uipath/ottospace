# A terminal: a selection made with the mouse, then ⌘C and the copied pulse (record it: --record).
{"cmd":"split"}
{"cmd":"wait","pattern":"^\\$"}
{"cmd":"type","text":"clear && printf 'alpha beta gamma\\ndelta epsilon\\n'\r"}
{"cmd":"wait","pattern":"^delta epsilon$"}
{"cmd":"mouse_down","x":0.25,"y":0.5}
{"cmd":"mouse_drag","x":10.75,"y":0.5}
{"shot":"selected"}
{"record":"start"}
{"sleep_ms":400}
{"cmd":"key","keys":"cmd-c"}
{"sleep_ms":1200}
{"record":"stop"}
{"shot":"copied"}

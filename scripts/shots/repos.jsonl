# The Repos section: repositories, linked worktrees on their branches (one long), and a terminal opened in one.
{"cmd":"section","section":"repos"}
{"until":"repos_bar.2"}
{"shot":"list"}
{"cmd":"open_repo","path":"{ROOT}/repos/canvas-app-2"}
{"shot":"opened"}
# A task in a repository: its row carries the task's badge, and a click on it selects the task.
# One on the long branch: the branch is cut short before the badge, never under it.
{"cmd":"task_new","line":"Rework zoom and pan >canvas-app-3"}
{"cmd":"task_new","line":"Fix the canvas zoom >canvas-app"}
{"shot":"task-badge"}
{"click":"repo:{ROOT}/repos/canvas-app"}
{"shot":"task-selected"}

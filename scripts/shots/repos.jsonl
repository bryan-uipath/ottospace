# The Repos section: repositories, a linked worktree on its branch, and a terminal opened in one.
{"cmd":"section","section":"repos"}
{"until":"repos_bar.2"}
{"shot":"list"}
{"cmd":"open_repo","path":"{ROOT}/repos/canvas-app-2"}
{"shot":"opened"}
# A task in a repository: its row carries the task's badge, and a click on it selects the task.
{"cmd":"task_new","line":"Fix the canvas zoom >canvas-app"}
{"shot":"task-badge"}
{"click":"repo:{ROOT}/repos/canvas-app"}
{"shot":"task-selected"}

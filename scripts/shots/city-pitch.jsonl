# The code city's pitch (`code_city`), for the owner to pick the default: the fitted view (38° down),
# then turned by the user's vertical drag to 52°, 30° and 24° (0.4° a point, the first eighth of a
# small drag is the click's slop), each from Reset view. code-city's small repository (`app`;
# city-pitch/ is a link to code-city/) and a made-up tree of 2,000 (`big`), each a repository's tab, the new-task drawer folded (⌘⇧R).
{"env":{"OTTOSPACE_FEATURES":"code_city"}}
{"tree":"repos/big","files":2000}
{"cmd":"repo_add","path":"{ROOT}/repos/big"}
{"until":"repos_bar.1"}
{"cmd":"section","section":"repos"}
{"cmd":"open_repo","path":"{ROOT}/repos/app"}
{"cmd":"close"}
{"cmd":"key","keys":"escape","as":"user"}
{"cmd":"key","keys":"cmd-shift-r","as":"user"}
{"until":"city.picture","timeout_ms":30000}
{"settle":800}
{"shot":"app-38"}
{"drag":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[0,35]}
{"settle":800}
{"shot":"app-52"}
{"click":"city:reset:tab"}
{"settle":800}
{"drag":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[0,-23]}
{"settle":800}
{"shot":"app-30"}
{"click":"city:reset:tab"}
{"settle":800}
{"drag":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[0,-35]}
{"settle":800}
{"shot":"app-24"}
{"click":"city:reset:tab"}
{"cmd":"open_repo","path":"{ROOT}/repos/big"}
{"cmd":"close"}
{"cmd":"key","keys":"escape","as":"user"}
{"until":"city.places","is":2096,"timeout_ms":60000}
{"settle":800}
{"shot":"big-38"}
{"drag":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[0,35]}
{"settle":800}
{"shot":"big-52"}
{"click":"city:reset:tab"}
{"settle":800}
{"drag":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[0,-23]}
{"settle":800}
{"shot":"big-30"}
{"click":"city:reset:tab"}
{"settle":800}
{"drag":{"rect":"city.bounds"},"at":[0.5,0.8],"by":[0,-35]}
{"settle":800}
{"shot":"big-24"}

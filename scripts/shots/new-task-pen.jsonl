# The box's ✎ (⌘⇧M, `overlay_panels`): the box tucks away, the pane in use freezes and is marked
# up with no bar; ↵ is the box again with the capture as a pill, its marked part cropped.
{"write":"home/settings.json","text":"{\"repos\": [], \"features\": {\"overlay_panels\": true}}\n"}
{"until":"state.features","is":["overlay_panels"]}
{"click":"top:new_workspace"}
{"cmd":"key","keys":"cmd-d","as":"user"}
{"cmd":"type","pane":1,"text":"clear; echo 'cart total: 42.00 (2 codes applied, 1 ignored)'\r"}
{"cmd":"key","keys":"cmd-n","as":"user"}
{"cmd":"key","keys":"f i x space t h e space c a r t space t o t a l","as":"user"}
{"cmd":"key","keys":"cmd-shift-m","as":"user"}
{"until":"capture.picture","exists":true}
{"settle":500}
{"drag":{"rect":"capture.picture"},"at":[0.02,0.02],"by":[360,40]}
{"settle":300}
{"shot":"marking"}
{"cmd":"key","keys":"enter","as":"user"}
{"settle":500}
{"shot":"pill"}

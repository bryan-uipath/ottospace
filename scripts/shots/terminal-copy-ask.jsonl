# A program asks to set the clipboard (OSC 52): the pill in its pane's header, nothing copied.
{"cmd":"split"}
{"cmd":"wait","pattern":"^\\$"}
{"cmd":"type","text":"clear; printf '\\033]52;c;%s\\a' \"$(printf 'git push --force\\nrm -rf build\\n' | base64)\"; echo asked-$((1+1))\r"}
{"cmd":"wait","pattern":"^asked-2$"}
{"settle":600}
{"shot":"pill"}

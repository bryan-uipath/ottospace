# Reads and searches in the code city (`code_city`): one task's agent replays
# city-glimmer/fixtures, a Grep every 0.9 s over `m1`, then `m0`, each naming two made-up files.
# Each search sweeps a band across its folder; the files its result names stay lit (`searching`,
# a second later `again`). Waits by time: a base with no effects takes the same two pictures.
{"env": {"OTTOSPACE_FEATURES": "code_city"}}
{"tree": "repos/app", "files": 60}
{"cmd": "repo_add", "path": "{ROOT}/repos/app"}
{"until": "repos_bar.0"}
{"cmd": "task_new", "line": "tidy the parser >app"}
{"cmd": "section", "section": "tasks"}
{"click": "task:1", "at": [0.3, 0.3]}
{"click": "talk:talk-start"}
{"cmd": "key", "keys": "cmd-shift-r", "as": "user"}
{"cmd": "open_space", "space": {"kind": "task", "id": 1}}
{"until": "city.agents", "len": 1, "timeout_ms": 30000}
{"settle": 7000}
{"shot": "searching"}
{"settle": 1300}
{"shot": "again"}

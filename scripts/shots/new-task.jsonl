# The new-task box: empty, being typed in, with a folder the agent will run in, a bare mark, and several lines.
{"env":{"OTTOSPACE_PATH_HOME":"{ROOT}/user"}}
{"cmd":"split","kind":"empty"}
{"cmd":"compose"}
{"shot":"empty"}
{"cmd":"key","keys":"f i x space t h e space e x p o r t space # c a n v","as":"user"}
{"shot":"typing"}
{"cmd":"key","keys":"escape escape","as":"user"}
{"cmd":"compose","text":"summarise this week "}
{"cmd":"key","keys":"~ / n o t e s / 2","as":"user"}
{"until":"compose_menu.rows.0"}
{"cmd":"key","keys":"tab","as":"user"}
{"until":"compose_folder","is":"~/notes/2026/"}
{"shot":"folder"}
# A bare `>`: its first row is highlighted, and ↵ completes it.
{"cmd":"key","keys":"escape escape","as":"user"}
{"cmd":"compose","text":"fix it "}
{"cmd":"key","keys":">","as":"user"}
{"until":"compose_menu.rows.0"}
{"shot":"bare-mark"}
# Several lines: the title, then more (⇧↵), wrapped and grown.
{"cmd":"key","keys":"escape escape","as":"user"}
{"cmd":"compose","text":"fix the zoom flicker on resize in the canvas"}
{"cmd":"key","keys":"shift-enter i t space f l i c k e r s space w h e n space t h e space w i n d o w space i s space d r a g g e d space b y space i t s space c o r n e r space a n d space t h e space p a n e s space r e d r a w","as":"user"}
{"settle":300}
{"shot":"lines"}

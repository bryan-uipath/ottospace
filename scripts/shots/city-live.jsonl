# The code city on its live layer (`city_live_layer`): drawn straight to a Metal layer under the
# window's content, the window transparent only over the city's rectangle. A repository's tab
# after its terminal closed (`tab`: the hints' translucent backing over the city), a terminal
# beside it (`beside`: the layer follows the place), another tab (`other-tab`: the layer hidden,
# no hole), and back (`back`). A made-up tree of 400 files.
{"env":{"OTTOSPACE_FEATURES":"code_city,city_live_layer"}}
{"tree":"repos/app","files":400}
{"cmd":"repo_add","path":"{ROOT}/repos/app"}
{"until":"repos_bar.0"}
{"cmd":"open_repo","path":"{ROOT}/repos/app"}
{"cmd":"close"}
{"until":"city.picture"}
{"settle":1500}
{"shot":"tab"}
{"cmd":"split","axis":"right"}
{"settle":1500}
{"shot":"beside"}
{"cmd":"new_tab"}
{"settle":1000}
{"shot":"other-tab"}
{"cmd":"cycle_tab","delta":-1}
{"settle":1500}
{"shot":"back"}
